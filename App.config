<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Legacy public HTTPS update manifest. Leave empty when GitHub Release is used. -->
    <add key="UpdateManifestUrl" value="" />

    <!--
      Private GitHub Release update source. The read-only access token is never
      stored here: configure it once from MCPanel and it is DPAPI-protected in
      StoreData for the current Windows user.
    -->
    <add key="GitHubUpdateRepository" value="vguangshen/MCPanel" />

    <!--
      Environment package URLs. After publishing, edit the matching values in
      MCPanel.exe.config beside the executable. Changes apply to the next install.
      IIS itself is enabled through Windows; its URL below is the URL Rewrite MSI.
    -->
    <add key="Environment.Iis.UrlRewriteUrl" value="http://regservice.itmc.cn/down/tomcat/URLRewrite.msi" />
    <add key="Environment.Nginx.PackageUrl" value="http://regservice.itmc.cn/down/tomcat/nginx-1.14.2.zip" />
    <add key="Environment.MySql.PackageUrl" value="http://regservice.itmc.cn/down/mysql/mysql.zip" />
    <add key="Environment.SqlServer.Sql2025ExpressUrl" value="https://download.microsoft.com/download/7ab8f535-7eb8-4b16-82eb-eca0fa2d38f3/SQL2025-SSEI-Expr.exe" />
    <add key="Environment.SqlServer.Sql2025EnterpriseDeveloperUrl" value="https://aka.ms/sql2025EnterpriseDev" />
    <add key="Environment.SqlServer.Sql2022ExpressUrl" value="https://download.microsoft.com/download/5/1/4/5145fe04-4d30-4b85-b0d1-39533663a2f1/SQL2022-SSEI-Expr.exe" />
    <add key="Environment.SqlServer.Sql2017ExpressUrl" value="https://download.microsoft.com/download/5/E/9/5E9B18CC-8FD5-467E-B5BF-BADE39C51F73/SQLServer2017-SSEI-Expr.exe" />
    <add key="Environment.SqlServer.Sql2012ExpressX64Url" value="https://download.microsoft.com/download/b/d/e/bde8fad6-33e5-44f6-b714-348f73e602b6/SQLEXPR_x64_ENU.exe" />
    <add key="Environment.SqlServer.Sql2012ExpressX86Url" value="https://download.microsoft.com/download/b/d/e/bde8fad6-33e5-44f6-b714-348f73e602b6/SQLEXPR_x86_ENU.exe" />
    <add key="Environment.SqlServer.Sql2008ExpressX64Url" value="http://regservice.itmc.cn/down/SQLServer/SQLEXPR_2008_x64.exe" />
    <add key="Environment.SqlServer.Sql2008ExpressX86Url" value="http://regservice.itmc.cn/down/SQLServer/SQLEXPR_2008_x86.exe" />
    <add key="Environment.Tomcat.PackageUrl" value="http://regservice.itmc.cn/down/tomcat/apache-tomcat-8.5.57.zip" />
    <add key="Environment.Frp.PackageUrl" value="https://github.com/fatedier/frp/releases/download/v0.71.0/frp_0.71.0_windows_amd64.zip" />

    <!-- AI Chat Completions configuration. ApiKey is intentionally editable here. -->
    <add key="Ai.Provider" value="GLM" />
    <add key="Ai.Endpoint" value="https://open.bigmodel.cn/api/paas/v4/chat/completions" />
    <add key="Ai.Model" value="glm-5.2" />
    <add key="Ai.ApiKey" value="" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>
</configuration>
