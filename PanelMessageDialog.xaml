<Window x:Class="MCPanel.PanelMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="680"
        Height="420"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DialogLineBrush" Color="#DADCE0" />
        <SolidColorBrush x:Key="DialogTextBrush" Color="#202124" />
        <SolidColorBrush x:Key="DialogMutedBrush" Color="#5F6368" />
        <SolidColorBrush x:Key="DialogPrimaryBrush" Color="#1A73E8" />
        <SolidColorBrush x:Key="DialogPrimaryHoverBrush" Color="#1765CC" />
        <SolidColorBrush x:Key="DialogTonalBrush" Color="#E8F0FE" />
        <SolidColorBrush x:Key="DialogTonalTextBrush" Color="#174EA6" />
        <SolidColorBrush x:Key="DialogDangerBrush" Color="#D93025" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B7C0CC" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#7E8A99" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1A73E8" />

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DialogTonalTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource DialogTonalBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.74" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{DynamicResource DialogPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource DialogPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Border x:Name="DialogSurface"
            Background="{DynamicResource DialogSurfaceBrush}"
            BorderBrush="{DynamicResource DialogLineBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.30" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconText"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="21"
                           Foreground="{DynamicResource DialogPrimaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DialogTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,18,0,22"
                    Background="Transparent"
                    BorderBrush="{DynamicResource DialogLineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <ScrollViewer x:Name="MessageScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              Focusable="True">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                    </ScrollViewer.Resources>
                    <TextBlock x:Name="MessageText"
                               TextWrapping="Wrap"
                               FontSize="13"
                               LineHeight="21"
                               Foreground="{DynamicResource DialogMutedBrush}" />
                </ScrollViewer>
            </Border>

            <StackPanel x:Name="ButtonsPanel"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right" />
        </Grid>
    </Border>
</Window>
