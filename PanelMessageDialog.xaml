<Window x:Class="MCPanel.PanelMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="680"
        Height="420"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/PanelDialogControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="DialogSurface"
            Background="{DynamicResource DialogSurfaceBrush}"
            BorderBrush="{DynamicResource DialogLineBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.30" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconText"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="21"
                           Foreground="{DynamicResource DialogPrimaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DialogTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,18,0,22"
                    Background="Transparent"
                    BorderBrush="{DynamicResource DialogLineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <ScrollViewer x:Name="MessageScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              Focusable="True">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                    </ScrollViewer.Resources>
                    <TextBlock x:Name="MessageText"
                               TextWrapping="Wrap"
                               FontSize="13"
                               LineHeight="21"
                               Foreground="{DynamicResource DialogMutedBrush}" />
                </ScrollViewer>
            </Border>

            <StackPanel x:Name="ButtonsPanel"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right" />
        </Grid>
    </Border>
</Window>
