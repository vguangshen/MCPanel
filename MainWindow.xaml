                            CornerRadius="8"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource CardLineBrush}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Margin" Value="64,0,8,0" />
                                <Setter Property="Padding" Value="16,0" />
                                <Setter Property="MaxHeight" Value="0" />
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManagementExpanded}" Value="True">
                                        <Setter Property="Margin" Value="64,14,8,0" />
                                        <Setter Property="Padding" Value="16,11" />
                                        <Setter Property="MaxHeight" Value="180" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                     From="0" To="180"
                                                                     Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1"
                                                                     Duration="0:0:0.14" />
                                                    <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                        From="64,0,8,0" To="64,14,8,0"
                                                                        Duration="0:0:0.22">
                                                        <ThicknessAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </ThicknessAnimation.EasingFunction>
                                                    </ThicknessAnimation>
                                                    <ThicknessAnimation Storyboard.TargetProperty="Padding"
                                                                        From="16,0" To="16,11"
                                                                        Duration="0:0:0.18">
                                                        <ThicknessAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </ThicknessAnimation.EasingFunction>
                                                    </ThicknessAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                     To="0"
                                                                     Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0"
                                                                     Duration="0:0:0.11" />
                                                    <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                        To="64,0,8,0"
                                                                        Duration="0:0:0.18">
                                                        <ThicknessAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </ThicknessAnimation.EasingFunction>
                                                    </ThicknessAnimation>
                                                    <ThicknessAnimation Storyboard.TargetProperty="Padding"
                                                                        To="16,0"
                                                                        Duration="0:0:0.16">
                                                        <ThicknessAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </ThicknessAnimation.EasingFunction>
                                                    </ThicknessAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="网站管理" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="打开、维护部署绑定，或从面板中移除该产品。"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,18,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" ItemHeight="34">
                                <Button Content="启动应用" Style="{StaticResource WebsitePrimaryActionButton}" Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Tag="Start" Click="InstalledProductTomcatAction_Click"
                                        IsEnabled="{Binding CanStartTomcatProduct}"
                                        Visibility="{Binding IsTomcatDeployment, Converter={StaticResource BooleanToVisibility}}" />
                                <Button Content="Catalina 诊断" Style="{StaticResource WebsiteActionButton}" Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Tag="Catalina" Click="InstalledProductTomcatAction_Click"
                                        IsEnabled="{Binding CanStartTomcatProduct}"
                                        Visibility="{Binding IsTomcatDeployment, Converter={StaticResource BooleanToVisibility}}" />
                                <Button Content="停止应用" Style="{StaticResource WebsiteActionButton}" Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Tag="Stop" Click="InstalledProductTomcatAction_Click"
                                        IsEnabled="{Binding CanStopTomcatProduct}"
                                        Visibility="{Binding IsTomcatDeployment, Converter={StaticResource BooleanToVisibility}}" />
                                <Button Content="{Binding ManagementButtonText}" Style="{StaticResource WebsiteActionButton}" MinWidth="98" Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Click="InstalledProductIis_Click" />
                                <Button Content="修复绑定" Style="{StaticResource WebsiteActionButton}" Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Click="InstalledProductRepair_Click" />
                                <Button Content="域名与 SSL" Style="{StaticResource WebsiteActionButton}" Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Click="InstalledProductDomain_Click" />
                                <Button Content="卸载" Style="{StaticResource WebsiteDangerActionButton}" MinWidth="76"
                                        VerticalAlignment="Center"
                                        Click="InstalledProductUninstall_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource PageBrush}" ClipToBounds="True">
        <Viewbox x:Name="MainViewbox"
                 Stretch="Uniform"
                 StretchDirection="Both"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
        <Grid x:Name="DesignSurface"
              Width="1280"
              Height="820"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              FocusManager.IsFocusScope="True"
              Background="{DynamicResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="212" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="Assets/AppIcon/mcpanel-logo.png"
                           Width="42"
                           Height="42"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="MCPanel" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click"
                            ToolTip="最小化" AutomationProperties.Name="最小化" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click"
                            ToolTip="最大化" AutomationProperties.Name="最大化" />
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" Click="Close_Click"
                            ToolTip="关闭到托盘" AutomationProperties.Name="关闭到托盘" />
                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid x:Name="NavRail" DockPanel.Dock="Top" Margin="0,16,0,0" ClipToBounds="True">
                        <StackPanel x:Name="NavItemsPanel">
                        <RadioButton x:Name="HomeNavButton" Style="{StaticResource NavItem}" Content="首页" Tag="&#xE80F;" IsChecked="True" Checked="Nav_Checked" CommandParameter="Home" />
                        <RadioButton Style="{StaticResource NavItem}" Content="网站" Tag="&#xE7F4;" Checked="Nav_Checked" CommandParameter="Sites" />
                        <RadioButton Style="{StaticResource NavItem}" Content="产品管理" Tag="&#xE8B7;" Checked="Nav_Checked" CommandParameter="Products" />
                        <RadioButton Style="{StaticResource NavItem}" Content="环境" Tag="&#xE7F8;" Checked="Nav_Checked" CommandParameter="Environment" />
                        <RadioButton Style="{StaticResource NavItem}" Content="账号 API" Tag="&#xE8D4;" Checked="Nav_Checked" CommandParameter="AccountApi" />
                        <RadioButton Style="{StaticResource NavItem}" Content="AI 分析" Tag="&#xE99A;" Checked="Nav_Checked" CommandParameter="AiAnalysis" />
                        <RadioButton Style="{StaticResource NavItem}" Content="面板设置" Tag="&#xE713;" Checked="Nav_Checked" CommandParameter="Settings" />
                        </StackPanel>
                    </Grid>

                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24" Background="{DynamicResource PageBrush}">
                <Border x:Name="PageFocusSentinel"
                        Width="1"
                        Height="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Focusable="True"
                        AutomationProperties.Name="当前页面内容" />
                <ScrollViewer x:Name="HomePage"
                                  VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="True"
                              KeyboardNavigation.TabNavigation="Local">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                    </ScrollViewer.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="22,16" Height="80">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="系统概览" Style="{StaticResource SectionTitle}" FontSize="20" />
                                <TextBlock Text="{Binding UptimeText}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="720" Margin="24,0,0,0">
                                <TextBlock Text="{Binding HardwareCpuText}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding HardwareMemoryText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextAlignment="Right" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding HardwareOsText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextAlignment="Right" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,10" Margin="0,10,0,0" Height="162">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="资源统计" Style="{StaticResource SectionTitle}" FontSize="17" />
                                <UniformGrid Columns="2" Margin="0,6,0,0">
                                    <Grid Margin="0,0,14,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="90" />
                                            <RowDefinition Height="20" />
                                        </Grid.RowDefinitions>
                                        <Grid Width="86" Height="86" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <local:CircularProgress x:Name="CpuProgress" Value="{Binding CpuUsage}" ProgressBrush="{DynamicResource PrimaryBrush}" TrackBrush="{DynamicResource DisabledBrush}" Width="86" Height="86" StrokeThickness="9" />
                                            <TextBlock Text="{Binding AnimatedValue, ElementName=CpuProgress, StringFormat={}{0:N0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="CPU" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="90" />
                                            <RowDefinition Height="20" />
                                        </Grid.RowDefinitions>
                                        <Grid Width="86" Height="86" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <local:CircularProgress x:Name="MemoryProgress" Value="{Binding MemoryUsage}" ProgressBrush="{DynamicResource MemoryBrush}" TrackBrush="{DynamicResource DisabledBrush}" Width="86" Height="86" StrokeThickness="9" />
                                            <TextBlock Text="{Binding AnimatedValue, ElementName=MemoryProgress, StringFormat={}{0:N0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="内存" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                </UniformGrid>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{DynamicResource LineBrush}" Margin="6,4,20,4" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="磁盘" Style="{StaticResource SectionTitle}" FontSize="17" />
                                <ItemsControl ItemsSource="{Binding Drives}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="158" ItemHeight="48" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="152" Height="48" Margin="0,0,6,0" HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <local:CircularProgress Value="{Binding PercentUsed}" ProgressBrush="{DynamicResource PrimaryBrush}" TrackBrush="{DynamicResource DisabledBrush}" Width="48" Height="48" StrokeThickness="5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PercentUsed, StringFormat={}{0:N0}%}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="16,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="套件服务" Style="{StaticResource SectionTitle}" FontSize="18" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Services}" Margin="10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardLineBrush}" BorderThickness="1" Padding="10" Margin="0,0,8,8" Height="166">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="1" Height="28" CornerRadius="12" Padding="8,0" VerticalAlignment="Center"
                                                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardLineBrush}" BorderThickness="1">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Ellipse Width="8" Height="8" Fill="{Binding BadgeBrush}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding BadgeText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                                                               LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                        <StackPanel Grid.Row="1" Margin="0,6,0,6">
                                                            <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="17" />
                                                            <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="17" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Grid Grid.Row="2">
                                                            <UniformGrid Columns="3" Visibility="{Binding ServiceControlsVisibility}">
                                                                <Button Content="启动" Style="{StaticResource EnvironmentPrimaryButton}" Width="64" Height="26" FontSize="11" Margin="0,0,6,0" Click="ServiceAction_Click" Tag="Start" IsEnabled="{Binding CanStart}" />
                                                                <Button Content="停止" Style="{StaticResource EnvironmentTonalButton}" Width="64" Height="26" FontSize="11" Margin="0,0,6,0" Click="ServiceAction_Click" Tag="Stop" IsEnabled="{Binding CanStop}" />
                                                                <Button Content="重启" Style="{StaticResource EnvironmentTonalButton}" Width="64" Height="26" FontSize="11" Margin="0" Click="ServiceAction_Click" Tag="Restart" IsEnabled="{Binding CanRestart}" />
                                                            </UniformGrid>
                                                            <TextBlock Text="安装组件后可启动服务"
                                                                       Visibility="{Binding InstallHintVisibility}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>
                </ScrollViewer>

                <Grid x:Name="ProductsPage" Visibility="Collapsed"
                      Focusable="True"
                      KeyboardNavigation.TabNavigation="Local">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="ProductsHeader"
                            Style="{StaticResource Card}"
                            Padding="20,16"
                            SizeChanged="ProductsHeader_SizeChanged">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="420" />
                                <ColumnDefinition Width="132" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="产品仓库" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding ProductStoreStatus}" ToolTip="{Binding ProductStoreStatus}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="1" Margin="18,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Border Height="40"
                                        Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="14,0,0,0"
                                                   IsHitTestVisible="False" />
                                        <TextBox x:Name="SearchBox"
                                                 Height="38"
                                                 Margin="38,0,8,0"
                                                 FontSize="14"
                                                 Padding="0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalContentAlignment="Center"
                                                 Focusable="True"
                                                 IsTabStop="True"
                                                 IsEnabled="True"
                                                 ToolTip="输入产品名称、编号或分类"
                                                 AutomationProperties.Name="搜索产品" 
                                                 TextChanged="SearchBox_TextChanged" />
                                        <TextBlock Text="搜索产品名称、编号或分类"
                                                   Margin="38,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="14"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1"
                                      Width="64"
                                      Height="40"
                                      HorizontalAlignment="Left"
                                      Margin="7,0,0,0"
                                      VerticalAlignment="Center">
                                    <local:CircularProgress Value="{Binding InstallationProgress.OverallDownloadProgress}"
                                                            Width="48"
                                                            Height="48"
                                                            StrokeThickness="3"
                                                            ProgressBrush="{DynamicResource PrimaryBrush}"
                                                            TrackBrush="{DynamicResource DisabledBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            IsHitTestVisible="False"
                                                            Visibility="{Binding InstallationProgress.IsDownloading, Converter={StaticResource BooleanToVisibility}}" />
                                    <Button x:Name="DownloadQueueButton"
                                            Style="{StaticResource ProductToolbarIconButton}"
                                            Margin="0"
                                            Panel.ZIndex="2"
                                            ToolTip="展开下载与安装进度"
                                            AutomationProperties.Name="展开下载与安装进度"
                                            PreviewMouseLeftButtonDown="DownloadQueueButton_PreviewMouseLeftButtonDown"
                                            Click="DownloadQueueButton_Click">
                                        <Grid Width="30" Height="30" IsHitTestVisible="False">
                                            <TextBlock Text="&#xE896;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Border Width="18"
                                                    Height="18"
                                                    CornerRadius="9"
                                                    Background="{DynamicResource PrimaryBrush}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Visibility="{Binding InstallationProgress.HasActiveQueue, Converter={StaticResource BooleanToVisibility}}">
                                                <TextBlock Text="{Binding InstallationProgress.ActiveQueueCount}"
                                                           Foreground="White"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>
                            <Button Grid.Column="2" Content="刷新在线列表" Style="{StaticResource TonalButton}" Margin="14,0,0,0" Click="RefreshProducts_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14,14,8" Margin="0,12,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding ProductCategories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayText}"
                                                Style="{StaticResource ProductCategoryChip}"
                                                Click="ProductCategory_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProductCountText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Top"
                                       Margin="18,7,4,0" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="ProductsList"
                             Grid.Row="2"
                             ItemsSource="{Binding VisibleProductRows}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12"
                                      HorizontalAlignment="Left"
                                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource SubtractConverter}, ConverterParameter=28}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Content="{Binding Item1}"
                                                    ContentTemplate="{StaticResource ProductCardTemplate}"
                                                    Margin="0,0,12,0" />
                                    <ContentControl Grid.Column="1"
                                                    Content="{Binding Item2}"
                                                    ContentTemplate="{StaticResource ProductCardTemplate}"
                                                    Margin="0,0,12,0">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Style.Triggers>
                                                    <Trigger Property="Content" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                    <ContentControl Grid.Column="2"
                                                    Content="{Binding Item3}"
                                                    ContentTemplate="{StaticResource ProductCardTemplate}"
                                                    Margin="0,0,12,0">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Style.Triggers>
                                                    <Trigger Property="Content" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
