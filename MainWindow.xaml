                                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding ProductId}" FontSize="13" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextBrush}" />
                                                                        <TextBlock Text="{Binding ContextPath, StringFormat=上下文：{0}}"
