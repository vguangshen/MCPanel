<Window x:Class="MCPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MCPanel"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="MCPanel"
        Icon="Assets/AppIcon/mcpanel-logo.ico"
        Width="1024"
        Height="656"
        MinWidth="600"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FocusManager.FocusedElement="{Binding ElementName=HomeNavButton}"
        PreviewMouseLeftButtonDown="MainWindow_PreviewMouseLeftButtonDown"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        BorderThickness="0"
        Background="{DynamicResource PageBrush}">
        <shell:WindowChrome.WindowChrome>
            <shell:WindowChrome CaptionHeight="0"
                                ResizeBorderThickness="6"
                                GlassFrameThickness="0"
                                CornerRadius="12"
                                UseAeroCaptionButtons="False" />
        </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/PanelTheme.xaml" />
                <ResourceDictionary Source="Resources/PanelModalChrome.xaml" />
                <ResourceDictionary Source="Resources/MainWindowTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource PageBrush}" ClipToBounds="True">
        <Viewbox x:Name="MainViewbox"
                 Stretch="Uniform"
                 StretchDirection="Both"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
        <Grid x:Name="DesignSurface"
              Width="1280"
              Height="820"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              FocusManager.IsFocusScope="True"
              Background="{DynamicResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="212" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="Assets/AppIcon/mcpanel-logo.png"
                           Width="42"
                           Height="42"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="MCPanel" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click"
                            ToolTip="最小化" AutomationProperties.Name="最小化" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click"
                            ToolTip="最大化" AutomationProperties.Name="最大化" />
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" Click="Close_Click"
                            ToolTip="关闭到托盘" AutomationProperties.Name="关闭到托盘" />
                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid x:Name="NavRail" DockPanel.Dock="Top" Margin="0,16,0,0" ClipToBounds="True">
                        <StackPanel x:Name="NavItemsPanel">
                        <RadioButton x:Name="HomeNavButton" Style="{StaticResource NavItem}" Content="首页" Tag="&#xE80F;" IsChecked="True" Checked="Nav_Checked" CommandParameter="Home" />
                        <RadioButton Style="{StaticResource NavItem}" Content="网站" Tag="&#xE7F4;" Checked="Nav_Checked" CommandParameter="Sites" />
                        <RadioButton Style="{StaticResource NavItem}" Content="产品管理" Tag="&#xE8B7;" Checked="Nav_Checked" CommandParameter="Products" />
                        <RadioButton Style="{StaticResource NavItem}" Content="环境" Tag="&#xE7F8;" Checked="Nav_Checked" CommandParameter="Environment" />
                        <RadioButton Style="{StaticResource NavItem}" Content="账号 API" Tag="&#xE8D4;" Checked="Nav_Checked" CommandParameter="AccountApi" />
                        <RadioButton Style="{StaticResource NavItem}" Content="AI 分析" Tag="&#xE99A;" Checked="Nav_Checked" CommandParameter="AiAnalysis" />
                        <RadioButton Style="{StaticResource NavItem}" Content="面板设置" Tag="&#xE713;" Checked="Nav_Checked" CommandParameter="Settings" />
                        </StackPanel>
                    </Grid>

                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24" Background="{DynamicResource PageBrush}">
                <Border x:Name="PageFocusSentinel"
                        Width="1"
                        Height="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Focusable="True"
                        AutomationProperties.Name="当前页面内容" />
                <ScrollViewer x:Name="HomePage"
                                  VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="True"
                              KeyboardNavigation.TabNavigation="Local">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                    </ScrollViewer.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="HomeSystemSummaryCard"
                            Style="{StaticResource Card}"
                            Padding="22,16"
                            Height="92">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.55*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="系统概览" Style="{StaticResource SectionTitle}" FontSize="20" />
                                <TextBlock Text="{Binding UptimeText}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="24,0,0,0">
                                <TextBlock x:Name="HomeHardwareCpuText"
                                           Text="{Binding HardwareCpuText}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="12"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                                <TextBlock x:Name="HomeHardwareMemoryText"
                                           Text="{Binding HardwareMemoryText}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12"
                                           TextAlignment="Right"
                                           Margin="0,2,0,0"
                                           TextWrapping="NoWrap" />
                                <TextBlock x:Name="HomeHardwareOsText"
                                           Text="{Binding HardwareOsText}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12"
                                           TextAlignment="Right"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,10" Margin="0,10,0,0" Height="162">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="资源统计" Style="{StaticResource SectionTitle}" FontSize="17" />
                                <UniformGrid Columns="2" Margin="0,6,0,0">
                                    <Grid Margin="0,0,14,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="90" />
                                            <RowDefinition Height="20" />
                                        </Grid.RowDefinitions>
                                        <Grid Width="86" Height="86" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <local:CircularProgress x:Name="CpuProgress" Value="{Binding CpuUsage}" ProgressBrush="{DynamicResource PrimaryBrush}" TrackBrush="{DynamicResource DisabledBrush}" Width="86" Height="86" StrokeThickness="9" />
                                            <TextBlock Text="{Binding AnimatedValue, ElementName=CpuProgress, StringFormat={}{0:N0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="CPU" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="90" />
                                            <RowDefinition Height="20" />
                                        </Grid.RowDefinitions>
                                        <Grid Width="86" Height="86" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <local:CircularProgress x:Name="MemoryProgress" Value="{Binding MemoryUsage}" ProgressBrush="{DynamicResource MemoryBrush}" TrackBrush="{DynamicResource DisabledBrush}" Width="86" Height="86" StrokeThickness="9" />
                                            <TextBlock Text="{Binding AnimatedValue, ElementName=MemoryProgress, StringFormat={}{0:N0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="内存" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                </UniformGrid>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{DynamicResource LineBrush}" Margin="6,4,20,4" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="磁盘" Style="{StaticResource SectionTitle}" FontSize="17" />
                                <ItemsControl ItemsSource="{Binding Drives}"
                                              ItemTemplate="{StaticResource DriveStatTemplate}"
                                              Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="158" ItemHeight="48" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="16,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="套件服务" Style="{StaticResource SectionTitle}" FontSize="18" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Services}"
                                          ItemTemplate="{StaticResource ServiceStatusTemplate}"
                                          Margin="10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding HomeServiceColumnCount}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>
                </ScrollViewer>

                <Grid x:Name="ProductsPage" Visibility="Collapsed"
                      Focusable="True"
                      ClipToBounds="True"
                      IsVisibleChanged="ProductsPage_IsVisibleChanged"
                      PreviewKeyDown="ProductsPage_PreviewKeyDown"
                      KeyboardNavigation.TabNavigation="Local">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="ProductsHeader"
                            Style="{StaticResource Card}"
                            Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="420" />
                                <ColumnDefinition Width="132" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="产品仓库" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding ProductStoreStatus}" ToolTip="{Binding ProductStoreStatus}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
                            </StackPanel>
                            <Grid x:Name="ProductsSearchHost" Grid.Column="1" Margin="18,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Border Height="40"
                                        Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="14,0,0,0"
                                                   IsHitTestVisible="False" />
                                        <TextBox x:Name="SearchBox"
                                                 Height="38"
                                                 Margin="38,0,8,0"
                                                 FontSize="14"
                                                 Padding="0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalContentAlignment="Center"
                                                 Focusable="True"
                                                 IsTabStop="True"
                                                 IsEnabled="True"
                                                 ToolTip="输入产品名称、编号或分类"
                                                 AutomationProperties.Name="搜索产品" 
                                                 TextChanged="SearchBox_TextChanged" />
                                        <TextBlock Text="搜索产品名称、编号或分类"
                                                   Margin="38,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="14"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1"
                                      Width="64"
                                      Height="40"
                                      HorizontalAlignment="Left"
                                      Margin="7,0,0,0"
                                      VerticalAlignment="Center">
                                    <local:CircularProgress Value="0"
                                                            IsIndeterminate="{Binding InstallationProgress.IsQueueActivityAnimating}"
                                                            Width="48"
                                                            Height="48"
                                                            StrokeThickness="3"
                                                            ProgressBrush="{DynamicResource PrimaryBrush}"
                                                            TrackBrush="{DynamicResource DisabledBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            IsHitTestVisible="False"
                                                            Visibility="{Binding InstallationProgress.HasActiveQueue, Converter={StaticResource BooleanToVisibility}}" />
                                    <Button x:Name="DownloadQueueButton"
                                            Style="{StaticResource ProductToolbarIconButton}"
                                            Margin="0"
                                            Panel.ZIndex="2"
                                            ToolTip="展开下载与安装进度"
                                            AutomationProperties.Name="展开下载与安装进度"
                                            PreviewMouseLeftButtonDown="DownloadQueueButton_PreviewMouseLeftButtonDown"
                                            Click="DownloadQueueButton_Click">
                                        <Grid Width="30" Height="30" IsHitTestVisible="False">
                                            <TextBlock Text="&#xE896;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Border Width="18"
                                                    Height="18"
                                                    CornerRadius="9"
                                                    Background="{DynamicResource PrimaryBrush}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Visibility="{Binding InstallationProgress.HasActiveQueue, Converter={StaticResource BooleanToVisibility}}">
                                                <TextBlock Text="{Binding InstallationProgress.ActiveQueueCount}"
                                                           Foreground="White"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>
                            <Button x:Name="RefreshProductsButton" Grid.Column="2" Content="刷新在线列表" Style="{StaticResource TonalButton}" Margin="14,0,0,0" Click="RefreshProducts_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14,14,8" Margin="0,12,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding ProductCategories}"
                                          ItemTemplate="{StaticResource ProductCategoryChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProductCountText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Top"
                                       Margin="18,7,4,0" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="ProductsList"
                             Grid.Row="2"
                             ItemsSource="{Binding VisibleProductRows}"
                             ItemTemplate="{StaticResource ProductGridRowTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                       </ListBox.ItemsPanel>
                   </ListBox>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24" Visibility="{Binding ProductNoResultsVisibility}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="没有找到匹配的产品" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                            <TextBlock Text="调整产品分类或搜索条件后再试。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,16" />
                            <Button Content="清除筛选" Style="{StaticResource TonalButton}" HorizontalAlignment="Center" Click="ClearProductFilters_Click" />
                        </StackPanel>
                    </Border>
                    <Grid x:Name="DownloadQueueFlyoutLayer"
                          Grid.RowSpan="3"
                          Panel.ZIndex="200"
                          Width="460"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,86,16,0"
                          Visibility="Collapsed"
                          Focusable="False">
            <Grid x:Name="DownloadQueueFlyoutHost" Width="460">
                <Border x:Name="DownloadQueueFlyoutCard"
                        Width="460"
                        MaxHeight="540"
                        Padding="16"
                        RenderTransformOrigin="0.66,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource CardLineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.Resources>
                            <Style x:Key="DownloadQueueTabButton" TargetType="RadioButton">
                                <Setter Property="Height" Value="34" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="TabRoot" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource TonalBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TonalTextBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="下载与安装队列" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding InstallationProgress.QueuePanelSummaryText}" Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border Grid.Row="1" Margin="0,12,0,8" Padding="3" CornerRadius="8"
                                Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardLineBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="DownloadQueueActiveTab" Grid.Column="0" GroupName="DownloadQueueTabs" Style="{StaticResource DownloadQueueTabButton}"
                                             IsChecked="{Binding InstallationProgress.ShowActiveQueue, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="下载中" VerticalAlignment="Center" />
                                        <Border MinWidth="22" Height="18" Margin="7,0,0,0" Padding="6,0" Background="{DynamicResource InputBrush}" CornerRadius="9">
                                            <TextBlock Text="{Binding InstallationProgress.ActiveQueueCount}" FontSize="9.5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="DownloadQueueCompletedTab" Grid.Column="1" GroupName="DownloadQueueTabs" Style="{StaticResource DownloadQueueTabButton}"
                                             IsChecked="{Binding InstallationProgress.ShowCompletedQueue, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="已完成" VerticalAlignment="Center" />
                                        <Border MinWidth="22" Height="18" Margin="7,0,0,0" Padding="6,0" Background="{DynamicResource InputBrush}" CornerRadius="9">
                                            <TextBlock Text="{Binding InstallationProgress.CompletedQueueCount}" FontSize="9.5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid Visibility="{Binding InstallationProgress.ShowActiveQueue, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,46"
                                            Visibility="{Binding InstallationProgress.ActiveQueueEmptyVisibility}">
                                    <TextBlock Text="当前没有下载或安装任务" Foreground="{DynamicResource TextBrush}" FontSize="12.5"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="新任务加入后会自动显示在这里" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
                                               Margin="0,5,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                                <ScrollViewer MaxHeight="390" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding InstallationProgress.ActiveQueueItemsVisibility}">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <ItemsControl x:Name="DownloadQueueItemsControl"
                                                  ItemsSource="{Binding InstallationProgress.ActiveQueueItems}"
                                                  ItemTemplate="{StaticResource InstallationQueueItemTemplate}" />
                                </ScrollViewer>
                            </Grid>

                            <Grid Visibility="{Binding InstallationProgress.ShowCompletedQueue, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,46"
                                            Visibility="{Binding InstallationProgress.CompletedQueueEmptyVisibility}">
                                    <TextBlock Text="还没有已完成的任务记录" Foreground="{DynamicResource TextBrush}" FontSize="12.5"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="任务结束后会自动移动到这里" Foreground="{DynamicResource MutedBrush}" FontSize="12.5"
