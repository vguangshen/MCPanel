        <Style x:Key="ProductInstallButton" TargetType="Button" BasedOn="{StaticResource WebsitePrimaryActionButton}">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
