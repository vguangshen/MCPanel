                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="使用顶部按钮绑定已下载的平台，或先在产品管理中安装产品。也可以添加自定义 IIS 网站。"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,18" />
                            <Button Content="新建 IIS 网站"
                                    Style="{StaticResource WebsitePrimaryActionButton}"
                                    HorizontalAlignment="Center"
                                    MinWidth="132"
                                    Click="CustomWebsiteCreate_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource FooterBrush}" Padding="24,0">
            <Grid>
                <TextBlock Text="功能：环境安装、网站部署、反向代理、数据库工具与诊断分析。" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding VersionText, StringFormat=MCPanel  软件版本({0})}" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>


        <Grid x:Name="InstallationOverlay" Grid.RowSpan="3"
              Panel.ZIndex="100"
              Background="#78000000"
              Visibility="{Binding InstallationProgress.IsVisible, Converter={StaticResource BooleanToVisibility}}">
            <Border Style="{StaticResource PanelModalSurface}"
                    MaxWidth="{Binding ActualWidth, ElementName=InstallationOverlay, Converter={StaticResource SubtractConverter}, ConverterParameter=24}"
                    MaxHeight="{Binding ActualHeight, ElementName=InstallationOverlay, Converter={StaticResource SubtractConverter}, ConverterParameter=24}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.34" Color="#000000" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                    </ScrollViewer.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" CornerRadius="7"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource CardLineBrush}" BorderThickness="1">
                            <Image Source="{Binding InstallationProgress.IconPath}" Margin="5" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding InstallationProgress.OperationTitle}"
                                       Foreground="{DynamicResource TonalTextBrush}"
                                       FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding InstallationProgress.ProductName}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="20" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding InstallationProgress.ProductId}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border CornerRadius="13" Padding="10,5"
                                    Background="{DynamicResource TonalBrush}">
                                <TextBlock Text="{Binding InstallationProgress.StageText}"
                                           Foreground="{DynamicResource TonalTextBrush}"
                                           FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <Button Content="隐藏"
                                    MinWidth="54"
                                    Height="28"
                                    Margin="8,0,0,0"
                                    Padding="6,0"
                                    FontSize="11"
                                    Style="{StaticResource RoundedRectButton}"
                                    ToolTip="隐藏窗口，当前操作继续在后台进行"
                                    Click="HideInstallationProgress_Click" />
                        </StackPanel>
                    </Grid>

                        <Grid Grid.Row="1" Margin="0,24,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            </Grid.RowDefinitions>
                        <Grid>
                                <TextBlock Text="当前阶段" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding InstallationProgress.TransferText}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding InstallationProgress.DownloadSpeedText}"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBlock Text="{Binding InstallationProgress.ProgressText}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Grid.Row="1"
                                     Style="{StaticResource ProductNativeProgress}"
                                     Value="{Binding InstallationProgress.DisplayDownloadProgress, Mode=OneWay}"
                                     Maximum="100"
                                     IsIndeterminate="{Binding InstallationProgress.IsProgressIndeterminate}"
                                     Margin="0,8,0,0" />
                    </Grid>

                    <Border Grid.Row="2" Margin="0,20,0,0" Padding="14,12"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource CardLineBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TonalTextBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding InstallationProgress.DetailText}"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding InstallationProgress.TransferText}"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="104" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="最近处理记录" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" FontWeight="SemiBold" />
                        <Border Grid.Row="1" Margin="0,8,0,0" Padding="12,8"
                                Background="{DynamicResource PageBrush}" CornerRadius="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding InstallationProgress.RecentEvents}"
                                              ItemTemplate="{StaticResource InstallationRecentEventTemplate}">
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,20,0,0">
                        <TextBlock Text="{Binding InstallationProgress.ElapsedText}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="隐藏（后台继续）"
                                    MinWidth="140"
                                    Height="34"
                                    Style="{StaticResource TonalButton}"
                                    Click="HideInstallationProgress_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
        </Grid>
        </Viewbox>
    </Grid>
</Window>
