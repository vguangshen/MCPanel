                                                    <Button Content="管理" Style="{StaticResource EnvironmentTonalButton}" HorizontalAlignment="Left" Click="FrpOpenManagement_Click" IsEnabled="{Binding CanManage}" Visibility="{Binding FrpManagementVisibility}" />
