                                                <Button Content="卸载" Width="58" Height="28" FontSize="11" Padding="8,0" Style="{StaticResource RoundedRectDangerButton}" Margin="0,0,6,0"
                                                        Click="DatabaseToolAction_Click" Tag="SsmsUninstall" IsEnabled="{Binding CanUninstall}" />
                                                <Button Content="连接" Width="58" Height="28" FontSize="11" Padding="8,0" Style="{StaticResource RoundedRectTonalButton}" Margin="0,0,6,0"
                                                        Click="DatabaseToolAction_Click" Tag="SsmsConnect" IsEnabled="{Binding CanConnect}" />
                                                <Button Content="配置路径" Width="76" Height="28" FontSize="11" Padding="8,0" Style="{StaticResource RoundedRectTonalButton}"
                                                        Click="DatabaseToolAction_Click" Tag="SsmsConfigure" IsEnabled="{Binding CanConfigure}" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="7,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="存储与目录" Style="{StaticResource SectionTitle}" FontSize="18" />
                                        <TextBlock Text="统一管理运行环境、产品、缓存和诊断文件的位置。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource CardLineBrush}"
                                             BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TonalTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding StoreDataRoot}" Foreground="{DynamicResource TextBrush}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding StoreDataRoot}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="所有路径均位于当前软件目录下，迁移时可以和程序及相关数据一并转移。"
                                                Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
                                    <UniformGrid Grid.Row="3" Columns="4" Margin="0,8,0,0">
                                        <Button Content="数据目录" MinWidth="0" Height="34" FontSize="12" Padding="8,0" Style="{StaticResource RoundedRectButton}" Margin="0,0,7,0" Click="SettingsAction_Click" Tag="OpenStoreData" />
                                        <Button Content="运行环境" MinWidth="0" Height="34" FontSize="12" Padding="8,0" Style="{StaticResource RoundedRectTonalButton}" Margin="0,0,7,0" Click="SettingsAction_Click" Tag="OpenRuntime" />
                                        <Button Content="产品目录" MinWidth="0" Height="34" FontSize="12" Padding="8,0" Style="{StaticResource RoundedRectTonalButton}" Margin="0,0,7,0" Click="SettingsAction_Click" Tag="OpenProducts" />
                                        <Button Content="诊断日志" MinWidth="0" Height="34" FontSize="12" Padding="8,0" Style="{StaticResource RoundedRectTonalButton}" Margin="0" Click="SettingsAction_Click" Tag="OpenLogs" />
                                    </UniformGrid>
                                    <Grid Grid.Row="4" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="产品缓存" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ProductCacheSizeText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="8,1,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="清理" Width="66" Height="30" FontSize="11" Style="{StaticResource RoundedRectTonalButton}"
                                                Click="SettingsAction_Click" Tag="ClearProductCache" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="软件更新" Style="{StaticResource SectionTitle}" FontSize="18" />
                                        <TextBlock Text="程序文件可安全更新，StoreData、Web 产品与运行环境保持不变。"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="0,10,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                   Foreground="{DynamicResource TonalTextBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="在线更新" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="从 GitHub 私有 Release 读取更新，校验 HTTPS 与 SHA-256"
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,12,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="配置 GitHub" Width="92" Height="34" FontSize="11"
                                                Margin="0,0,8,0" Style="{StaticResource WebsiteActionButton}" IsEnabled="{Binding CanStartUpdate}"
                                                Click="ConfigureGitHubUpdate_Click" />
                                        <Button Grid.Column="3" Content="检查并更新" Width="112" Height="34" FontSize="11"
                                                Style="{StaticResource WebsitePrimaryActionButton}" IsEnabled="{Binding CanStartUpdate}"
                                                Click="CheckOnlineUpdate_Click" />
                                    </Grid>

                                    <Border Grid.Row="2" Background="{DynamicResource LineBrush}" />

                                    <Grid Grid.Row="3" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                   Foreground="{DynamicResource TonalTextBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="本地更新" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="选择离线 ZIP，完成版本、路径与校验检查后安装"
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,12,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="选择更新包" Width="112" Height="34" FontSize="11"
                                                Style="{StaticResource WebsiteActionButton}" IsEnabled="{Binding CanStartUpdate}"
                                                Click="LocalUpdate_Click" />
                                    </Grid>

                                    <Grid Grid.Row="4" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource TonalTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding UpdateStatus}" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding UpdateStatus}" />
                                    </Grid>

                                    <Grid Grid.Row="5" Margin="0,8,0,0"
                                          Visibility="{Binding IsUpdateBusy, Converter={StaticResource BooleanToVisibility}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ProgressBar Style="{StaticResource MetricProgress}" Value="{Binding UpdateProgress}" Maximum="100"
                                                     Height="6" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <Button Grid.Column="1" Content="取消" Width="70" Height="30" FontSize="11"
                                                Style="{StaticResource WebsiteActionButton}" IsEnabled="{Binding CanCancelUpdate}"
                                                Click="CancelApplicationUpdate_Click" />
                                     </Grid>
                                 </Grid>
                             </Border>

                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,10" Margin="0"
                                    VerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="外观主题" Style="{StaticResource SectionTitle}" FontSize="18" />
                                        <TextBlock Grid.Row="1" Text="选择面板的显示主题，支持跟随系统、浅色与夜间模式。"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <UniformGrid Grid.Row="2" Columns="3" Margin="0,10,0,0">
                                            <RadioButton Content="跟随系统" Tag="System" GroupName="ThemeMode" Style="{StaticResource ThemeSegmentButton}" Margin="0,0,8,0" IsChecked="{Binding IsThemeSystemSelected, Mode=OneWay}" Click="ThemeMode_Click" />
                                            <RadioButton Content="浅色" Tag="Light" GroupName="ThemeMode" Style="{StaticResource ThemeSegmentButton}" Margin="0,0,8,0" IsChecked="{Binding IsThemeLightSelected, Mode=OneWay}" Click="ThemeMode_Click" />
                                            <RadioButton Content="夜间" Tag="Dark" GroupName="ThemeMode" Style="{StaticResource ThemeSegmentButton}" IsChecked="{Binding IsThemeDarkSelected, Mode=OneWay}" Click="ThemeMode_Click" />
                                        </UniformGrid>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{DynamicResource LineBrush}" />
                                    <Grid Grid.Row="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="开机自启动" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="登录 Windows 后仅驻留托盘，单击托盘图标再打开面板"
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Content="启用" VerticalAlignment="Center" Margin="16,0,0,0"
                                                  IsChecked="{Binding IsStartupEnabled, Mode=TwoWay}" Click="StartupToggle_Click"
                                                  FontSize="13" Foreground="{DynamicResource TextBrush}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="SitesPage" Visibility="Collapsed"
                      Focusable="True"
                      KeyboardNavigation.TabNavigation="Local">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="18,10" Height="78">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="已安装网站" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding InstalledProductStatus}" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="13" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding InstalledProductCountText}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,0,14,0" />
                                <Button Content="新建 IIS 网站" Style="{StaticResource WebsitePrimaryActionButton}"
                                        MinWidth="122" Click="CustomWebsiteCreate_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding WebsiteContentVisibility}">
                        <StackPanel>
                            <TextBlock Text="自定义 IIS 网站" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,9" />
                            <ItemsControl ItemsSource="{Binding CustomWebsites}" ItemTemplate="{StaticResource CustomWebsiteCardTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="已安装产品网站" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" Margin="2,8,0,9" />
                            <ItemsControl ItemsSource="{Binding InstalledProducts}" ItemTemplate="{StaticResource InstalledProductCardTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1"
                            Margin="0,12,0,0"
                            Padding="28"
                            Style="{StaticResource Card}"
                            Visibility="{Binding WebsiteEmptyVisibility}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                            <TextBlock Text="还没有网站"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="新建 IIS 网站，或先在产品管理中安装并部署产品。"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,18" />
                            <Button Content="新建 IIS 网站"
                                    Style="{StaticResource WebsitePrimaryActionButton}"
                                    HorizontalAlignment="Center"
                                    MinWidth="132"
                                    Click="CustomWebsiteCreate_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource FooterBrush}" Padding="24,0">
            <Grid>
                <TextBlock Text="功能：环境安装、网站部署、反向代理、数据库工具与诊断分析。" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding VersionText, StringFormat=MCPanel  软件版本({0})}" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Popup x:Name="DownloadQueuePopup"
               PlacementTarget="{Binding ElementName=ProductsHeader}"
               Placement="Custom"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="None"
               Opened="DownloadQueuePopup_Opened"
               Focusable="False"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <Grid x:Name="DownloadQueuePopupHost" Width="460">
                <Border x:Name="DownloadQueuePopupCard"
                        Width="460"
                        MaxHeight="560"
                        Padding="16"
                        RenderTransformOrigin="0.5,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource CardLineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="下载与安装队列"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding InstallationProgress.QueueSummaryText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Height="1"
                                Margin="0,12,0,8"
                                Background="{DynamicResource LineBrush}" />

                        <Grid Grid.Row="2">
                            <TextBlock Text="暂无下载或安装任务"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,18"
                                       Visibility="{Binding InstallationProgress.QueueEmptyVisibility}" />
                            <ScrollViewer MaxHeight="390"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding InstallationProgress.QueueItemsVisibility}">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                                </ScrollViewer.Resources>
                                <ItemsControl x:Name="DownloadQueueItemsControl"
                                              ItemsSource="{Binding InstallationProgress.QueueItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,10"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource LineBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="54" />
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="44" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding QueueNumberText}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="10"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding ProductName}"
                                                                   ToolTip="{Binding ProductName}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Foreground="{DynamicResource MutedBrush}"
                                                                   FontSize="10"
                                                                   Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding ProductId, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding StateText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ProgressText}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <Button Grid.Column="3"
                                                            Content="{Binding PauseActionText}"
                                                            ToolTip="{Binding PauseActionToolTip}"
                                                            Width="56"
                                                            Height="28"
                                                            Padding="7,0"
                                                            FontSize="10.5"
                                                            FontWeight="SemiBold"
                                                            HorizontalAlignment="Right"
                                                            Style="{StaticResource RoundedRectTonalButton}"
                                                            IsEnabled="{Binding CanTogglePause}"
                                                            Visibility="{Binding CanTogglePause, Converter={StaticResource BooleanToVisibility}}"
                                                            Click="ToggleQueuedProductPause_Click" />
                                                    <Button Grid.Column="4"
                                                            Content="删除"
                                                            ToolTip="{Binding RemoveToolTip}"
                                                            Width="38"
                                                            Height="28"
                                                            Padding="4,0"
                                                            FontSize="10"
                                                            HorizontalAlignment="Right"
                                                            Style="{StaticResource RoundedRectDangerButton}"
                                                            IsEnabled="{Binding CanRemove}"
                                                            Click="RemoveQueuedProduct_Click" />
                                                    <ProgressBar Grid.Row="1"
                                                                 Grid.ColumnSpan="5"
                                                                 Style="{StaticResource MetricProgress}"
                                                                 Value="{Binding Progress, Mode=OneWay}"
                                                                 Maximum="100"
                                                                 Margin="36,8,0,0" />
                                                    <TextBlock Grid.Row="2"
                                                               Grid.ColumnSpan="5"
                                                               Text="{Binding Message}"
                                                               ToolTip="{Binding Message}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="10"
                                                               Margin="36,6,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Text="任务按加入时间逐项处理；关闭面板或窗口到托盘不会中断后台下载、安装和部署。"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </Popup>

        <Grid Grid.RowSpan="3"
              Panel.ZIndex="100"
              Background="#78000000"
              Visibility="{Binding InstallationProgress.IsVisible, Converter={StaticResource BooleanToVisibility}}">
            <Border Width="620"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardLineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.34" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" CornerRadius="7"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource CardLineBrush}" BorderThickness="1">
                            <Image Source="{Binding InstallationProgress.IconPath}" Margin="5" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding InstallationProgress.OperationTitle}"
                                       Foreground="{DynamicResource TonalTextBrush}"
                                       FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding InstallationProgress.ProductName}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="20" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding InstallationProgress.ProductId}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border CornerRadius="13" Padding="10,5"
                                    Background="{DynamicResource TonalBrush}">
                                <TextBlock Text="{Binding InstallationProgress.StageText}"
                                           Foreground="{DynamicResource TonalTextBrush}"
                                           FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <Button Content="隐藏"
                                    Width="54"
                                    Height="28"
                                    Margin="8,0,0,0"
                                    Padding="6,0"
                                    FontSize="11"
                                    Style="{StaticResource RoundedRectButton}"
                                    ToolTip="隐藏窗口，下载和安装继续在后台进行"
                                    Click="HideInstallationProgress_Click" />
                        </StackPanel>
                    </Grid>

                        <Grid Grid.Row="1" Margin="0,24,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            </Grid.RowDefinitions>
                        <Grid>
                                <TextBlock Text="总体进度" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding InstallationProgress.TransferText}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding InstallationProgress.DownloadSpeedText}"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBlock Text="{Binding InstallationProgress.ProgressText}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Grid.Row="1"
                                     Style="{StaticResource ProductNativeProgress}"
                                     Value="{Binding InstallationProgress.Progress, Mode=OneWay}"
                                     Maximum="100"
                                     IsIndeterminate="{Binding InstallationProgress.IsProgressIndeterminate}"
                                     Margin="0,8,0,0" />
                    </Grid>

                    <Border Grid.Row="2" Margin="0,20,0,0" Padding="14,12"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource CardLineBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TonalTextBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding InstallationProgress.DetailText}"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding InstallationProgress.TransferText}"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="104" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="最近处理记录" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" FontWeight="SemiBold" />
                        <Border Grid.Row="1" Margin="0,8,0,0" Padding="12,8"
                                Background="{DynamicResource PageBrush}" CornerRadius="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernVerticalScrollBar}" />
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding InstallationProgress.RecentEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,20,0,0">
                        <TextBlock Text="{Binding InstallationProgress.ElapsedText}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="隐藏（后台继续）"
                                    Width="116"
                                    Height="34"
                                    Style="{StaticResource TonalButton}"
                                    Click="HideInstallationProgress_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Grid>
        </Viewbox>
    </Grid>
</Window>

