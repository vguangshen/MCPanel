                                                                            FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                            Content="&#xE74E;" ToolTip="保存端口"
                                                                            IsEnabled="{Binding CanSave}"
                                                                            Click="TomcatPortSave_Click" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <TextBlock Grid.Row="2" Text="{Binding TomcatPortNotice}" FontSize="11"
                                                       Foreground="{DynamicResource MemoryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
