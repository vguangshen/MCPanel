                        <StackPanel Margin="0,0,42,0">
                            <TextBlock Text="产品端口管理" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding TomcatPortSubtitle}" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="32" Height="32" MinWidth="0" Padding="0" Margin="0"
                                Style="{DynamicResource EnvironmentTonalButton}"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"
                                Content="&#xE7AD;" ToolTip="返回管理"
                                Click="EnvironmentCardFlip_Click" />
                    </Grid>

