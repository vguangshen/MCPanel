                                        <Button Grid.Column="1"
                                                Width="26" Height="26"
                                                MinWidth="0" Padding="0" Margin="0"
                                                VerticalAlignment="Center"
                                                Style="{DynamicResource EnvironmentTonalButton}"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Content="&#xE70F;"
                                                ToolTip="{Binding EditToolTip}"
                                                Visibility="{Binding EditVisibility}"
                                                Click="CredentialEdit_Click" />
                                        <Button Grid.Column="2"
                                                Width="26" Height="26"
                                                MinWidth="0" Padding="0" Margin="0"
                                                VerticalAlignment="Center"
                                                Style="{DynamicResource EnvironmentTonalButton}"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Content="&#xE8C8;"
                                                ToolTip="复制"
                                                Tag="{Binding Value}"
                                                CommandParameter="{Binding Label}"
                                                Click="CredentialCopy_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="2">
                        <TextBlock Text="{Binding CredentialNotice}" FontSize="11"
                                   Foreground="{DynamicResource MemoryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Content="连接工具"
                                HorizontalAlignment="Right"
                                Style="{DynamicResource EnvironmentWarningButton}"
                                Click="CredentialConnect_Click" />
                    </Grid>
                </Grid>
                <Grid Visibility="{Binding TomcatBackFaceVisibility}">
