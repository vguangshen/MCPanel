<ResourceDictionary x:Class="MCPanel.MainWindowTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MCPanel">
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

    <DataTemplate x:Key="ProductCardTemplate">
        <Border Style="{DynamicResource Card}"
                Padding="14"
                Height="190"
                HorizontalAlignment="Stretch"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52"
                            Height="52"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource CardLineBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                        <Image Source="{Binding IconPath}"
                               Stretch="Uniform"
                               Margin="4"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{Binding DisplayName}"
                                   ToolTip="{Binding DisplayName}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="42" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Border CornerRadius="9" Padding="7,2" Background="{DynamicResource TonalBrush}">
                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TonalTextBrush}" />
                            </Border>
                            <TextBlock Text="{Binding FamilyAndIdText}"
                                       ToolTip="{Binding FamilyAndIdText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,7,0,6">
                    <TextBlock Text="{Binding EnvironmentSummary}"
                               ToolTip="{Binding EnvironmentSummary}"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CompactStatusText}"
                               ToolTip="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,7,0,0"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding InstallActionText}"
                                Style="{DynamicResource ProductInstallButton}"
                                HorizontalAlignment="Left"
                                Click="ProductInstall_Click"
                                IsEnabled="{Binding CanProductAction}"
                                Visibility="{Binding InstallButtonVisibility}" />
                        <Button Content="{Binding UninstallActionText}"
                                Style="{DynamicResource ProductUninstallButton}"
                                HorizontalAlignment="Left"
                                Click="ProductUninstall_Click"
                                IsEnabled="{Binding CanProductAction}"
                                Visibility="{Binding UninstallButtonVisibility}" />
                        <Button Content="{Binding UpdateActionText}"
                                Style="{DynamicResource ProductUpdateButton}"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Left"
                                Click="ProductInstall_Click"
                                IsEnabled="{Binding CanUpdate}"
                                Visibility="{Binding UpdateButtonVisibility}" />
                    </StackPanel>
                    <Grid Grid.Column="1" Width="42" Height="42" HorizontalAlignment="Right">
                        <local:CircularProgress Value="{Binding DisplayDownloadProgress, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsDownloadProgressIndeterminate}"
                                                 ProgressBrush="{DynamicResource PrimaryBrush}"
                                                 TrackBrush="{DynamicResource DisabledBrush}"
                                                 Width="40"
                                                 Height="40"
                                                 StrokeThickness="5"
                                                 Visibility="{Binding ProgressIndicatorVisibility}" />
                        <TextBlock Text="{Binding DownloadProgressText}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ProgressIndicatorVisibility}" />
                        <Viewbox Width="40"
                                 Height="40"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 ToolTip="已安装"
                                 AutomationProperties.Name="已安装"
                                 Visibility="{Binding CompletedIndicatorVisibility}">
                            <Canvas Width="1024" Height="1024">
                                <Path Data="M460.8 694.044444L312.888889 546.133333c-2.844444-2.844444-2.844444-11.377778 0-14.222222l28.444444-28.444444c2.844444-2.844444 8.533333-2.844444 11.377778 0l108.088889 108.088889 247.466667-219.022223c5.688889-5.688889 11.377778-2.844444 17.066666 0l22.755556 25.6c5.688889 5.688889 5.688889 14.222222 0 19.911111l-287.288889 256z"
                                      Fill="#1afa29" />
                                <Path Data="M512 56.888889c250.311111 0 455.111111 204.8 455.111111 455.111111s-204.8 455.111111-455.111111 455.111111S56.888889 762.311111 56.888889 512 261.688889 56.888889 512 56.888889m0-56.888889C230.4 0 0 230.4 0 512s230.4 512 512 512 512-230.4 512-512S793.6 0 512 0z"
                                      Fill="#1afa29" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="CustomWebsiteCardTemplate">
        <Border Style="{DynamicResource Card}" Padding="18,15" Margin="0,0,0,10" MinHeight="122">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="1.65*" />
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource TonalBrush}" VerticalAlignment="Top">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                               Foreground="{DynamicResource TonalTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="SemiBold"
                                   MaxWidth="310" TextTrimming="CharacterEllipsis" />
                        <Border Width="20" Height="20" CornerRadius="10" Margin="9,0,0,0" BorderBrush="{DynamicResource CardLineBrush}" BorderThickness="1">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" />
                        </Border>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="6,3,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding PhysicalPath}" ToolTip="{Binding PhysicalPath}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Url}" ToolTip="{Binding Url}" Foreground="{DynamicResource TonalTextBrush}"
                               FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,18,0">
                    <TextBlock Text="{Binding DomainSummary}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SecuritySummary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,9,0,0" />
                    <TextBlock Text="{Binding PoolSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <WrapPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="访问" Style="{DynamicResource WebsitePrimaryActionButton}" Margin="0,0,7,0" Click="CustomWebsiteBrowse_Click" />
                    <Button Content="目录" Style="{DynamicResource WebsiteActionButton}" Margin="0,0,7,0" Click="CustomWebsiteOpenRoot_Click" />
                    <Button Content="编辑" Style="{DynamicResource WebsiteActionButton}" Margin="0,0,7,0" Click="CustomWebsiteEdit_Click" />
                    <Button Content="删除" Style="{DynamicResource WebsiteDangerActionButton}" Click="CustomWebsiteDelete_Click" />
                </WrapPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="InstalledProductCardTemplate">
        <Border Style="{DynamicResource Card}" Padding="18,16" Margin="0,0,0,10" MinHeight="138">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="142" />
                </Grid.ColumnDefinitions>

                <Border Width="52" Height="52" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource CardLineBrush}" BorderThickness="1" VerticalAlignment="Top">
                    <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <Grid Grid.Column="1" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MarqueeText Text="{Binding DisplayName}"
                                            Foreground="{DynamicResource TextBrush}"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Height="30"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding DisplayName}" />
                        <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11" Margin="8,0,0,0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource CardLineBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                ToolTip="{Binding RuntimeStatusText}">
                            <Ellipse Width="9" Height="9" Fill="{Binding RuntimeStatusBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding EnvironmentSummary}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Row="2"
                            Margin="0,8,0,0"
                            Padding="6,1"
                            Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource CardLineBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource PathIconButton}"
                                    Content="&#xE8B7;"
                                    ToolTip="打开软件安装目录"
                                    AutomationProperties.Name="打开软件安装目录"
                                    Click="InstalledProductOpen_Click" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding InstallPath}"
                                       ToolTip="{Binding InstallPath}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="2" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding DeploymentLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    <TextBlock Grid.Row="1" Text="{Binding SiteDisplayText}" Foreground="{DynamicResource TextBrush}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{Binding PoolDisplayText}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="3" Text="{Binding Url}" Foreground="{DynamicResource TonalTextBrush}"
                               FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"
                               Cursor="Hand" ToolTip="{Binding Url}"
                               MouseLeftButtonUp="InstalledProductUrl_Click" />
                    <TextBlock Grid.Row="4" Text="{Binding DomainDisplayText}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DomainDisplayText}" />
                </Grid>

                <Button Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{DynamicResource WebsiteManageButton}"
                        Click="InstalledProductManageToggle_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Margin="0,1,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="管理" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Margin="10,1,0,0"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManagementExpanded}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         To="180"
                                                                         Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         To="0"
                                                                         Duration="0:0:0.16">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="5"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource CardLineBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Margin" Value="64,0,8,0" />
                            <Setter Property="Padding" Value="16,0" />
                            <Setter Property="MaxHeight" Value="0" />
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsManagementExpanded}" Value="True">
                                    <Setter Property="Margin" Value="64,14,8,0" />
                                    <Setter Property="Padding" Value="16,11" />
                                    <Setter Property="MaxHeight" Value="250" />
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="IsHitTestVisible" Value="True" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                 From="0" To="250"
                                                                 Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1"
                                                                 Duration="0:0:0.14" />
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                    From="64,0,8,0" To="64,14,8,0"
                                                                    Duration="0:0:0.22">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                                <ThicknessAnimation Storyboard.TargetProperty="Padding"
                                                                    From="16,0" To="16,11"
                                                                    Duration="0:0:0.18">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                 To="0"
                                                                 Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0"
                                                                 Duration="0:0:0.11" />
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                    To="64,0,8,0"
                                                                    Duration="0:0:0.18">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn" />
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                                <ThicknessAnimation Storyboard.TargetProperty="Padding"
                                                                    To="16,0"
                                                                    Duration="0:0:0.16">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn" />
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="网站管理" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="打开、维护部署绑定，或从面板中移除该产品。"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,18,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" ItemHeight="34">
                            <Button Content="单独启动" Style="{DynamicResource WebsitePrimaryActionButton}" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Tag="Start" Click="InstalledProductTomcatAction_Click"
                                    IsEnabled="{Binding CanStartTomcatProduct}"
                                    Visibility="{Binding IsTomcatDeployment, Converter={StaticResource BooleanToVisibility}}" />
                            <Button Content="以 Catalina 方式启动" Style="{DynamicResource WebsiteActionButton}" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Tag="Catalina" Click="InstalledProductTomcatAction_Click"
                                    IsEnabled="{Binding CanStartTomcatProduct}"
                                    Visibility="{Binding IsTomcatDeployment, Converter={StaticResource BooleanToVisibility}}" />
                            <Button Content="查看日志" Style="{DynamicResource WebsiteActionButton}" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Tag="OpenLogs" Click="InstalledProductTomcatAction_Click"
                                    Visibility="{Binding IsTomcatDeployment, Converter={StaticResource BooleanToVisibility}}" />
                            <Button Content="IIS 管理" Style="{DynamicResource WebsiteActionButton}" MinWidth="98" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsIisDeployment, Converter={StaticResource BooleanToVisibility}}"
                                    Click="InstalledProductIis_Click" />
                            <Button Content="修复绑定" Style="{DynamicResource WebsiteActionButton}" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Click="InstalledProductRepair_Click" />
                            <Button Content="域名与 SSL" Style="{DynamicResource WebsiteActionButton}" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Click="InstalledProductDomain_Click" />
                            <Button Content="卸载" Style="{DynamicResource WebsiteDangerActionButton}" MinWidth="76"
                                    VerticalAlignment="Center"
                                    Click="InstalledProductUninstall_Click" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>
    <local:SubtractConverter x:Key="SubtractConverter" />

    <DataTemplate x:Key="ProductGridRowTemplate">
        <Grid Margin="0,0,0,12"
              HorizontalAlignment="Left"
              Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource SubtractConverter}, ConverterParameter=28}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding Item1}"
                            ContentTemplate="{StaticResource ProductCardTemplate}"
                            Margin="0,0,12,0" />
            <ContentControl Grid.Column="1"
                            Content="{Binding Item2}"
                            ContentTemplate="{StaticResource ProductCardTemplate}"
                            Margin="0,0,12,0">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl Grid.Column="2"
                            Content="{Binding Item3}"
                            ContentTemplate="{StaticResource ProductCardTemplate}"
                            Margin="0,0,12,0">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ProductCategoryChipTemplate">
        <Button Content="{Binding DisplayText}"
                Style="{DynamicResource ProductCategoryChip}"
                Click="ProductCategory_Click" />
    </DataTemplate>

    <DataTemplate x:Key="DatabaseToolCardTemplate">
        <Border Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource CardLineBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="11,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MatchedVersionText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="6,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10.5"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <Ellipse Width="7" Height="7">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource DangerTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource MemoryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10.5"
                                   Margin="6,0,0,0"
                                   MaxWidth="170"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StatusText}" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource CardLineBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,7"
                        Margin="0,7,0,0"
                        Tag="{Binding PathActionTag}"
                        MouseLeftButtonUp="DatabaseToolPath_Click"
                        IsHitTestVisible="{Binding CanOpenPath}"
                        Cursor="Hand"
                        ToolTip="{Binding PathText}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
