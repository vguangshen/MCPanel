                        <Button Content="停止" Style="{DynamicResource EnvironmentTonalButton}" Width="64" Height="26" FontSize="11" Margin="0,0,6,0" Click="ServiceAction_Click" Tag="Stop" IsEnabled="{Binding CanStop}" />
