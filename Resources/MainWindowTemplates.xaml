                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardLineBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding BadgeBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BadgeText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,6,0,6">
                    <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="17" />
                    <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}" Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="17" Margin="0,2,0,0" />
                </StackPanel>
                <Grid Grid.Row="2">
                    <UniformGrid Columns="3" Visibility="{Binding ServiceControlsVisibility}">
