    <DataTemplate x:Key="InstallationQueueItemTemplate">
        <Border Padding="8,10"
                Background="Transparent"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <Border Width="42"
                        Height="42"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource CardLineBrush}"
                        BorderThickness="1"
                        ToolTip="{Binding ProductName}"
                        AutomationProperties.Name="{Binding ProductName}">
                    <Image Source="{Binding IconPath}"
                           Stretch="Uniform"
                           Margin="3"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                    <TextBlock Text="{Binding ProductName}"
                               ToolTip="{Binding ProductName}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{DynamicResource MutedBrush}"
                               FontSize="10"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding ProductId, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding StateText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding ProgressText}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Button Grid.Column="3"
                        Content="{Binding PauseActionGlyph}"
                        ToolTip="{Binding PauseActionToolTip}"
                        AutomationProperties.Name="{Binding PauseActionToolTip}"
                        Style="{DynamicResource QueueIconButton}"
                        IsEnabled="{Binding CanTogglePause}"
                        Visibility="{Binding CanTogglePause, Converter={StaticResource BooleanToVisibility}}"
                        Click="ToggleQueuedProductPause_Click" />
                <Button Grid.Column="4"
                        Content="{Binding RemoveActionGlyph}"
                        ToolTip="{Binding RemoveToolTip}"
                        AutomationProperties.Name="{Binding RemoveToolTip}"
                        Style="{DynamicResource QueueDangerIconButton}"
                        IsEnabled="{Binding CanRemove}"
                        Click="RemoveQueuedProduct_Click" />
                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="5"
                             Style="{DynamicResource MetricProgress}"
                             Value="{Binding DisplayDownloadProgress, Mode=OneWay}"
                             Maximum="100"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Margin="62,8,0,0" />
                <TextBlock Grid.Row="2"
                           Grid.ColumnSpan="5"
                           Text="{Binding Message}"
                           ToolTip="{Binding Message}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="10"
                           Margin="62,6,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="3"
                           Grid.ColumnSpan="5"
                           Text="{Binding TransferText}"
                           ToolTip="{Binding TransferText}"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontSize="10"
                           Margin="62,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="InstallationQueueHistoryItemTemplate">
        <Border Padding="8,9,8,8" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Border Grid.RowSpan="2" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource CardLineBrush}" BorderThickness="1" ToolTip="{Binding ProductName}">
                    <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProductName}" ToolTip="{Binding ProductName}"
                               Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding ProductId, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Message, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" Height="26" MinWidth="64" Padding="8,0" CornerRadius="13"
                        Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardLineBrush}"
                        BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{Binding StateText}" FontSize="10.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgressText}" Value="完成">
                                        <Setter Property="Foreground" Value="{DynamicResource MemoryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProgressText}" Value="失败">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Button Grid.Column="3" Content="{Binding RemoveActionGlyph}" ToolTip="删除此记录"
                        AutomationProperties.Name="删除此记录" Style="{DynamicResource QueueDangerIconButton}"
                        IsEnabled="{Binding CanRemove}" VerticalAlignment="Top" Click="RemoveQueuedProduct_Click" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                           Text="{Binding CompletionTimeText}" ToolTip="{Binding CompletionTimeText}"
                           Foreground="{DynamicResource MutedBrush}" FontSize="9.5"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="10,5,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="InstallationRecentEventTemplate">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="5" Height="5" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource MutedBrush}"
                       FontSize="11" TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <!-- Environment card template with front, credential, and Tomcat views -->
    <DataTemplate x:Key="EnvironmentCardTemplate">
            <Border x:Name="EnvironmentCard" Style="{DynamicResource Card}" Margin="0,0,16,16"
                    Padding="18,16" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" />
                </Border.RenderTransform>
                <Grid>
                <Grid Visibility="{Binding FrontFaceVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Width="26" Height="26" MinWidth="0" Padding="0" Margin="7,0,0,0"
                                        Style="{DynamicResource PathIconButton}"
                                        Content="&#xE8B7;" ToolTip="打开安装目录"
                                        Visibility="{Binding InstallDirectoryVisibility}"
                                        Click="EnvironmentOpenDirectory_Click" />
                            </StackPanel>
                            <TextBlock Text="{Binding OptionLabel}" ToolTip="{Binding OptionLabel}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Height="28" VerticalAlignment="Top" Margin="12,0,0,0">
                            <Button Width="28" Height="28" Margin="0,0,8,0"
                                    MinWidth="0" Padding="0"
                                    Style="{DynamicResource EnvironmentTonalButton}"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Content="&#xE7AD;"
                                    ToolTip="查看管理信息"
                                    Click="EnvironmentCardFlip_Click"
                                    Visibility="{Binding EnvironmentFlipVisibility}" />
                            <Border Height="28" CornerRadius="12" Padding="8,0" VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardLineBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{Binding BadgeBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BadgeText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,10,0,10">
                        <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}" LineHeight="19" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ProgressStageText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" TextWrapping="NoWrap" FontSize="12" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding DownloadSpeedText}" Visibility="{Binding DownloadSpeedVisibility}" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="8,0,0,0" />
                        </Grid>
                        <ProgressBar Style="{DynamicResource MetricProgress}" Value="{Binding Progress, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsProgressIndeterminate}" />
                    </StackPanel>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Left">
                            <Button Content="{Binding ActionText}" Style="{DynamicResource EnvironmentPrimaryButton}" HorizontalAlignment="Left" Click="EnvironmentInstall_Click" IsEnabled="{Binding CanInstall}" Visibility="{Binding InstallButtonVisibility}" />
                            <ComboBox Style="{DynamicResource EnvironmentVersionComboBox}"
                                      ItemContainerStyle="{DynamicResource EnvironmentVersionComboBoxItem}"
                                      ItemsSource="{Binding MySqlReleaseOptions}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedMySqlReleaseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanSelectMySqlVersion}"
                                      Visibility="{Binding MySqlVersionSelectorVisibility}"
                                      Margin="0,0,8,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Style="{DynamicResource EnvironmentVersionComboBox}"
                                      ItemContainerStyle="{DynamicResource SqlServerEnvironmentVersionComboBoxItem}"
                                      ItemsSource="{Binding SqlServerReleaseOptions}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedSqlServerReleaseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanSelectSqlServerVersion}"
                                      Visibility="{Binding SqlServerVersionSelectorVisibility}"
                                      Margin="0,0,8,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayNameWithSupport}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   ToolTip="{Binding SupportNote}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="启动" Style="{DynamicResource EnvironmentPrimaryButton}" HorizontalAlignment="Left" Click="EnvironmentRuntime_Click" Tag="Start" IsEnabled="{Binding CanStart}" Visibility="{Binding ServiceControlsVisibility}" />
                            <Button Content="停止" Style="{DynamicResource EnvironmentTonalButton}" HorizontalAlignment="Left" Click="EnvironmentRuntime_Click" Tag="Stop" IsEnabled="{Binding CanStop}" Visibility="{Binding ServiceControlsVisibility}" />
                            <Button Content="重启" Style="{DynamicResource EnvironmentTonalButton}" HorizontalAlignment="Left" Click="EnvironmentRuntime_Click" Tag="Restart" IsEnabled="{Binding CanRestart}" Visibility="{Binding ServiceControlsVisibility}" />
                            <Button Content="卸载" Style="{DynamicResource EnvironmentTonalButton}" HorizontalAlignment="Left" Click="EnvironmentRuntime_Click" Tag="Uninstall" IsEnabled="{Binding CanUninstall}" Visibility="{Binding ServiceControlsVisibility}" />
                            <Button Content="以 Catalina 方式启动"
                                    Style="{DynamicResource EnvironmentWarningButton}"
                                    HorizontalAlignment="Left"
                                    Click="EnvironmentRuntime_Click"
                                    Tag="CatalinaRun"
                                    IsEnabled="{Binding CanStartCatalina}"
                                    Visibility="{Binding TomcatCatalinaVisibility}" />
                            <Button Content="连接 MySQL" Style="{DynamicResource EnvironmentWarningButton}" HorizontalAlignment="Left" Click="ConnectMySql_Click" IsEnabled="{Binding CanManage}" Visibility="{Binding MySqlConnectButtonVisibility}" />
                            <Button Content="连接 SQL Server" Style="{DynamicResource EnvironmentWarningButton}" HorizontalAlignment="Left" Click="ConnectSqlServer_Click" IsEnabled="{Binding CanManage}" Visibility="{Binding SqlServerConnectButtonVisibility}" />
                            <Button Content="管理" Style="{DynamicResource EnvironmentTonalButton}" HorizontalAlignment="Left" Click="EnvironmentRuntime_Click" Tag="OpenIis" IsEnabled="{Binding CanManage}" Visibility="{Binding IisManagementVisibility}" />
                            <Button Content="管理" Style="{DynamicResource EnvironmentTonalButton}" HorizontalAlignment="Left" Click="NginxOpenManagement_Click" IsEnabled="{Binding CanManage}" Visibility="{Binding NginxManagementVisibility}" />
                            <Button Content="管理" Style="{DynamicResource EnvironmentTonalButton}" HorizontalAlignment="Left" Click="FrpOpenManagement_Click" IsEnabled="{Binding CanManage}" Visibility="{Binding FrpManagementVisibility}" />
                    </WrapPanel>
                </Grid>
                <Grid Visibility="{Binding CredentialBackFaceVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding CredentialTitle}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding CredentialSubtitle}" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,4,18,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="32" Height="32"
                                MinWidth="0" Padding="0" Margin="0"
                                Style="{DynamicResource EnvironmentTonalButton}"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                Content="&#xE7AD;"
                                ToolTip="返回管理"
                                Click="EnvironmentCardFlip_Click" />
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding CredentialFields}" Margin="0,12,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource CardLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="10,7"
                                        Margin="0,0,8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Text="{Binding Value}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Margin="0,3,4,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Value}" />
