function BrandText(Parent: TWinControl; Text: String; X, Y, W, H, Size: Integer; Color: TColor; Bold: Boolean): TNewStaticText;
begin
  Result := TNewStaticText.Create(WizardForm);
  Result.Parent := Parent;
  Result.AutoSize := False;
  Result.WordWrap := True;
  Result.SetBounds(ScaleX(X), ScaleY(Y), ScaleX(W), ScaleY(H));
  Result.Caption := Text;
  Result.Font.Name := 'Microsoft YaHei UI';
  Result.Font.Size := Size;
  Result.Font.Color := Color;
  if Bold then Result.Font.Style := [fsBold];
end;

procedure InitializeBranding;
var Side, Card: TPanel; Logo: TBitmapImage; Note: TNewStaticText;
begin
  WizardForm.Caption := 'MCPanel · 部署工作台';
  WizardForm.ClientWidth := ScaleX(900);
  WizardForm.ClientHeight := ScaleY(560);
  WizardForm.Color := clWhite;
  WizardForm.Font.Name := 'Microsoft YaHei UI';
  WizardForm.Font.Size := 10;
  WizardForm.MainPanel.Visible := False;
  WizardForm.Bevel.Visible := False;
  WizardForm.Bevel1.Visible := False;
  WizardForm.WizardBitmapImage.Visible := False;
  WizardForm.WizardBitmapImage2.Visible := False;
  WizardForm.OuterNotebook.Align := alNone;
  WizardForm.InnerNotebook.Align := alNone;
  WizardForm.OuterNotebook.SetBounds(ScaleX(310), ScaleY(151), ScaleX(545), ScaleY(325));
  WizardForm.InnerNotebook.SetBounds(0, 0, ScaleX(545), ScaleY(325));
  Side := TPanel.Create(WizardForm);
  Side.Parent := WizardForm;
  Side.SetBounds(0, 0, ScaleX(270), ScaleY(560));
  Side.BevelOuter := bvNone;
  Side.ParentBackground := False;
  Side.StyleElements := [];
  Side.Color := $552D10;
  ExtractTemporaryFile('Brand.bmp');
  Logo := TBitmapImage.Create(WizardForm);
  Logo.Parent := Side;
  Logo.SetBounds(ScaleX(28), ScaleY(30), ScaleX(54), ScaleY(54));
  Logo.Stretch := True;
  Logo.Bitmap.LoadFromFile(ExpandConstant('{tmp}\Brand.bmp'));
  BrandText(Side, 'MCPanel', 96, 37, 160, 42, 22, clWhite, True);
  BrandText(Side, '部署与运维控制台', 28, 112, 220, 38, 17, clWhite, True);
  BrandText(Side, '从环境准备到服务上线', 28, 160, 220, 28, 10, $EBD1BC, False);
  BrandText(Side, '01   运行环境', 28, 248, 220, 30, 12, clWhite, True);
  BrandText(Side, 'IIS / Nginx / Tomcat / 数据库', 28, 284, 220, 28, 9, $EBD1BC, False);
  BrandText(Side, '02   网站部署', 28, 337, 220, 30, 12, clWhite, True);
  BrandText(Side, '站点配置、证书与产品部署', 28, 373, 220, 28, 9, $EBD1BC, False);
  BrandText(Side, '03   服务管理', 28, 426, 220, 30, 12, clWhite, True);
  BrandText(Side, '进程状态、FRP 与日常维护', 28, 462, 220, 28, 9, $EBD1BC, False);
  BrandText(Side, 'DEPLOY. MANAGE. SIMPLIFY.', 28, 520, 232, 22, 8, $EBD1BC, False);
  BrandHeading := BrandText(WizardForm, '准备你的部署工作台', 310, 32, 545, 45, 23, $4D2E17, True);
  BrandSubheading := BrandText(WizardForm, 'MCPanel {#AppVersion}  /  Windows x64', 312, 88, 540, 28, 10, $8C7564, False);
  BrandSteps := BrandText(WizardForm, '01  选择位置     /     02  准备环境     /     03  完成部署', 312, 123, 540, 25, 9, $CF5E20, False);
  WizardForm.SelectDirLabel.Visible := False;
  WizardForm.SelectDirBitmapImage.Visible := False;
  WizardForm.SelectDirBrowseLabel.SetBounds(0, ScaleY(14), ScaleX(545), ScaleY(25));
  WizardForm.SelectDirBrowseLabel.Caption := '安装位置';
  WizardForm.DirEdit.SetBounds(0, ScaleY(48), ScaleX(435), ScaleY(32));
  WizardForm.DirBrowseButton.SetBounds(ScaleX(449), ScaleY(47), ScaleX(96), ScaleY(34));
  WizardForm.DirBrowseButton.Caption := '选择目录';
  WizardForm.DiskSpaceLabel.Visible := False;
  Card := TPanel.Create(WizardForm);
  Card.Parent := WizardForm.SelectDirPage;
  Card.SetBounds(0, ScaleY(106), ScaleX(545), ScaleY(114));
  Card.BevelOuter := bvNone;
  Card.ParentBackground := False;
  Card.StyleElements := [];
  Card.Color := $FAF5EF;
  BrandText(Card, '环境就绪检查', 18, 13, 505, 26, 11, $4D2E17, True);
  DependencyStatus := BrandText(Card, '.NET Framework：' + DependencyText(DotNetAvailable) + #13#10 +
    'VC++ 2010 SP1 x64：' + DependencyText(VisualCppAvailable), 18, 48, 505, 56, 10, $6F4D33, False);
  DesktopShortcut := TNewCheckBox.Create(WizardForm);
  DesktopShortcut.Parent := WizardForm.SelectDirPage;
  DesktopShortcut.SetBounds(0, ScaleY(241), ScaleX(545), ScaleY(26));
  DesktopShortcut.Caption := '创建桌面快捷方式';
  DesktopShortcut.Checked := True;
  Note := BrandText(WizardForm.SelectDirPage, '所需运行库将自动准备。更新或修复安装时，已有配置、数据库和站点会保留。', 0, 282, 545, 40, 9, $8C7564, False);
  WizardForm.StatusLabel.SetBounds(0, ScaleY(35), ScaleX(545), ScaleY(45));
  WizardForm.ProgressGauge.SetBounds(0, ScaleY(103), ScaleX(545), ScaleY(12));
  WizardForm.FilenameLabel.SetBounds(0, ScaleY(135), ScaleX(545), ScaleY(70));
  WizardForm.FinishedHeadingLabel.Visible := False;
  WizardForm.FinishedLabel.SetBounds(0, ScaleY(28), ScaleX(545), ScaleY(100));
  WizardForm.RunList.SetBounds(0, ScaleY(160), ScaleX(545), ScaleY(95));
  WizardForm.NextButton.SetBounds(ScaleX(648), ScaleY(492), ScaleX(207), ScaleY(42));
  WizardForm.CancelButton.SetBounds(ScaleX(522), ScaleY(492), ScaleX(110), ScaleY(42));
  WizardForm.BackButton.SetBounds(ScaleX(310), ScaleY(492), ScaleX(110), ScaleY(42));
end;

procedure UpdateBrandPage(CurPageID: Integer);
begin
  if CurPageID = wpSelectDir then begin
    BrandHeading.Caption := '准备你的部署工作台';
    BrandSubheading.Caption := 'MCPanel {#AppVersion}  /  Windows x64';
    BrandSteps.Caption := '01  选择位置     /     02  准备环境     /     03  完成部署';
    WizardForm.NextButton.Caption := '开始安装 MCPanel';
  end else if CurPageID = wpFinished then begin
    BrandHeading.Caption := '部署工作台已就绪';
    BrandSubheading.Caption := '安装完成，开始管理你的运行环境与网站。';
    BrandSteps.Caption := '01  已选择位置     /     02  环境已就绪     /     03  部署完成';
    WizardForm.NextButton.Caption := '完成部署';
  end else begin
    BrandHeading.Caption := '正在准备部署工作台';
    BrandSubheading.Caption := '正在校验程序、准备环境并部署 MCPanel。';
  end;
end;
