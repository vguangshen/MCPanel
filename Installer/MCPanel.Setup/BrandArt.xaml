<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Vector redraw of the MCPanel app icon (Assets/AppIcon/mcpanel-logo.png):
      an open blue box receiving a cyan download arrow. 116 x 116 units.
      The parts are separate so the installer can animate them.
    -->
    <Geometry x:Key="BoxInterior">M31,33 L85,33 L91,56 L25,56 Z</Geometry>
    <Geometry x:Key="BoxFlapLeft">M31,33 L20,39.5 Q19,40 18.6,41 L12,59 Q11.6,61.2 13.8,60.6 L25,55.4 Z</Geometry>
    <Geometry x:Key="BoxFlapRight">M85,33 L96,39.5 Q97,40 97.4,41 L104,59 Q104.4,61.2 102.2,60.6 L91,55.4 Z</Geometry>
    <Geometry x:Key="BoxArrow">M49,16.5 L67,16.5 Q69.5,16.5 69.5,19 L69.5,38.5 L74,38.5 Q76.6,39.2 75,41.6 L60,57 Q58,58.8 56,57 L41,41.6 Q39.4,39.2 42,38.5 L46.5,38.5 L46.5,19 Q46.5,16.5 49,16.5 Z</Geometry>
    <Geometry x:Key="BoxLid">M27,56.5 L89,56.5 Q92,56.5 92.4,59.4 L93,65 Q93.2,68.5 89.8,68.5 L26.2,68.5 Q22.8,68.5 23,65 L23.6,59.4 Q24,56.5 27,56.5 Z</Geometry>
    <Geometry x:Key="BoxBody">M25,68.5 L91,68.5 L91,93 Q91,99.5 84.5,99.5 L31.5,99.5 Q25,99.5 25,93 Z</Geometry>
    <Geometry x:Key="BoxCutout">M55,72 L61,72 Q62.2,72 62.2,73.2 L62.2,80 L65.6,80 Q67.2,80.6 66.2,82 L59.2,89.6 Q58,90.8 56.8,89.6 L49.8,82 Q48.8,80.6 50.4,80 L53.8,80 L53.8,73.2 Q53.8,72 55,72 Z</Geometry>

    <LinearGradientBrush x:Key="BoxInteriorBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#0B4FC6" Offset="0" />
        <GradientStop Color="#0A3EA3" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BoxFlapLeftBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#5AB2FF" Offset="0" />
        <GradientStop Color="#3C8DF5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BoxFlapRightBrush" StartPoint="1,1" EndPoint="0,0">
        <GradientStop Color="#56A9FD" Offset="0" />
        <GradientStop Color="#2F7DEE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BoxArrowBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#45EAF8" Offset="0" />
        <GradientStop Color="#1FCDE9" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BoxLidBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#63D6FB" Offset="0" />
        <GradientStop Color="#46AEF8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BoxBodyBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3796FB" Offset="0" />
        <GradientStop Color="#1569E6" Offset="1" />
    </LinearGradientBrush>

    <!-- Small logo mark for the title area -->
    <DrawingImage x:Key="LogoMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,116,116" RadiusX="26" RadiusY="26" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource BoxInteriorBrush}" Geometry="{StaticResource BoxInterior}" />
                <GeometryDrawing Brush="{StaticResource BoxFlapLeftBrush}" Geometry="{StaticResource BoxFlapLeft}" />
                <GeometryDrawing Brush="{StaticResource BoxFlapRightBrush}" Geometry="{StaticResource BoxFlapRight}" />
                <GeometryDrawing Brush="{StaticResource BoxArrowBrush}" Geometry="{StaticResource BoxArrow}" />
                <GeometryDrawing Brush="{StaticResource BoxLidBrush}" Geometry="{StaticResource BoxLid}" />
                <GeometryDrawing Brush="{StaticResource BoxBodyBrush}" Geometry="{StaticResource BoxBody}" />
                <GeometryDrawing Brush="White" Geometry="{StaticResource BoxCutout}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- UI glyphs (24 x 24 grid unless noted) -->
    <Geometry x:Key="FolderGlyph">M2,5 Q2,3 4,3 L9,3 L11,5 L20,5 Q22,5 22,7 L22,18 Q22,20 20,20 L4,20 Q2,20 2,18 Z</Geometry>
