    <Geometry x:Key="ShieldGlyph">M12,2.5 L20,5.5 L20,11.5 Q20,18 12,21.5 Q4,18 4,11.5 L4,5.5 Z</Geometry>
    <Geometry x:Key="DatabaseGlyph">M4,6 Q4,3 12,3 Q20,3 20,6 L20,18 Q20,21 12,21 Q4,21 4,18 Z M4,6 Q4,9 12,9 Q20,9 20,6 M4,12 Q4,15 12,15 Q20,15 20,12</Geometry>
    <Geometry x:Key="TrashGlyph">M4,7 L20,7 M9,7 L9,4.5 L15,4.5 L15,7 M6,7 L7,20 L17,20 L18,7 M10,10.5 L10,16.5 M14,10.5 L14,16.5</Geometry>
</ResourceDictionary>
