<Window x:Class="MCPanel.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MCPanel.Setup"
        Title="MCPanel · 部署工作台"
        Width="944" Height="604"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid Margin="12">
        <!-- Shadow lives on its own layer so the content is not rasterized by the effect. -->
        <Border CornerRadius="16" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#0B2350" />
            </Border.Effect>
        </Border>

        <Grid x:Name="Root" Width="920" Height="580" Background="White">
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,920,580" RadiusX="16" RadiusY="16" />
            </Grid.Clip>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ======================= Brand stage ======================= -->
            <Grid x:Name="Stage" Background="{StaticResource StageBrush}" MouseLeftButtonDown="OnDrag" ClipToBounds="True">
                <Canvas x:Name="GridLayer" Opacity="0.08" IsHitTestVisible="False" />
                <Canvas x:Name="ParticleLayer" IsHitTestVisible="False" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="30,28,0,0">
                    <Image Source="{StaticResource LogoMark}" Width="34" Height="34" />
                    <TextBlock Text="MCPanel" Foreground="White" FontSize="20" FontWeight="Bold" Margin="11,0,0,0" VerticalAlignment="Center" />
                    <Border Background="#26FFFFFF" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionPill" Text="1.0.0" Foreground="#D9E8FF" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- Hero illustration: 300 x 300 -->
                <Canvas x:Name="Hero" Width="300" Height="300" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,92,0,0" IsHitTestVisible="False">
                    <Ellipse x:Name="Halo" Width="270" Height="270" Canvas.Left="15" Canvas.Top="15" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#5522D3EE" Offset="0" />
                                <GradientStop Color="#1A22D3EE" Offset="0.55" />
                                <GradientStop Color="#0022D3EE" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="HaloScale" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse Width="238" Height="238" Canvas.Left="31" Canvas.Top="31" Stroke="#1FFFFFFF" StrokeThickness="2" />
                    <local:ArcShape x:Name="ProgressArc" Width="238" Height="238" Canvas.Left="31" Canvas.Top="31"
                                    StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fraction="0">
                        <local:ArcShape.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7FE9FF" Offset="0" />
                                <GradientStop Color="#22D3EE" Offset="1" />
                            </LinearGradientBrush>
                        </local:ArcShape.Stroke>
                    </local:ArcShape>

                    <Canvas x:Name="Orbit" Width="300" Height="300" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="OrbitRotation" />
                        </Canvas.RenderTransform>
                        <Ellipse Width="9" Height="9" Fill="#7FE9FF" Canvas.Left="145.5" Canvas.Top="26.5" />
                        <Ellipse Width="6" Height="6" Fill="#A9C8FF" Canvas.Left="252" Canvas.Top="190" />
                        <Ellipse Width="5" Height="5" Fill="#FFFFFF" Opacity="0.7" Canvas.Left="40" Canvas.Top="200" />
                    </Canvas>

                    <!-- Deployed modules: pop out of the box as stages complete -->
                    <Border x:Name="ModuleRuntime" Canvas.Left="-4" Canvas.Top="38" Width="64" Height="64" CornerRadius="16" Background="#F2FFFFFF" RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Border.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="0.2" /></Border.RenderTransform>
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="#061A40" /></Border.Effect>
                        <StackPanel VerticalAlignment="Center">
                            <Path Data="{StaticResource RuntimeGlyph}" Stroke="#1A73E8" StrokeThickness="2" Width="24" Height="24" Stretch="Uniform" />
                            <TextBlock Text="运行环境" FontSize="10" Foreground="#0F1B2D" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ModuleWeb" Canvas.Left="118" Canvas.Top="-8" Width="64" Height="64" CornerRadius="16" Background="#F2FFFFFF" RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Border.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="0.2" /></Border.RenderTransform>
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="#061A40" /></Border.Effect>
                        <StackPanel VerticalAlignment="Center">
                            <Path Data="{StaticResource GlobeGlyph}" Stroke="#1A73E8" StrokeThickness="2" Width="24" Height="24" Stretch="Uniform" />
                            <TextBlock Text="网站部署" FontSize="10" Foreground="#0F1B2D" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ModuleService" Canvas.Left="240" Canvas.Top="38" Width="64" Height="64" CornerRadius="16" Background="#F2FFFFFF" RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Border.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="0.2" /></Border.RenderTransform>
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="#061A40" /></Border.Effect>
                        <StackPanel VerticalAlignment="Center">
                            <Path Data="{StaticResource ServiceGlyph}" Stroke="#1A73E8" StrokeThickness="2" Width="24" Height="24" Stretch="Uniform" />
                            <TextBlock Text="服务管理" FontSize="10" Foreground="#0F1B2D" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- The box: 116-unit art scaled to 174 px -->
                    <Canvas x:Name="Box" Width="116" Height="116" Canvas.Left="63" Canvas.Top="78" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                                <TranslateTransform x:Name="BoxShift" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Ellipse x:Name="BoxShadow" Width="86" Height="12" Canvas.Left="15" Canvas.Top="99" Fill="#40000C2A">
                            <Ellipse.Effect><BlurEffect Radius="6" /></Ellipse.Effect>
                        </Ellipse>
                        <Path Data="{StaticResource BoxInterior}" Fill="{StaticResource BoxInteriorBrush}" />
                        <Path x:Name="FlapLeft" Data="{StaticResource BoxFlapLeft}" Fill="{StaticResource BoxFlapLeftBrush}">
                            <Path.RenderTransform><RotateTransform x:Name="FlapLeftRotation" CenterX="25" CenterY="55" /></Path.RenderTransform>
                        </Path>
                        <Path x:Name="FlapRight" Data="{StaticResource BoxFlapRight}" Fill="{StaticResource BoxFlapRightBrush}">
                            <Path.RenderTransform><RotateTransform x:Name="FlapRightRotation" CenterX="91" CenterY="55" /></Path.RenderTransform>
                        </Path>
                        <Path x:Name="Arrow" Data="{StaticResource BoxArrow}" Fill="{StaticResource BoxArrowBrush}">
                            <Path.RenderTransform><TranslateTransform x:Name="ArrowShift" /></Path.RenderTransform>
                        </Path>
                        <Path Data="{StaticResource BoxLid}" Fill="{StaticResource BoxLidBrush}" />
                        <Path Data="{StaticResource BoxBody}" Fill="{StaticResource BoxBodyBrush}" />
                        <Path x:Name="Cutout" Data="{StaticResource BoxCutout}" Fill="White" />
                    </Canvas>

                    <!-- Result badges -->
                    <Grid x:Name="SuccessBadge" Width="58" Height="58" Canvas.Left="196" Canvas.Top="150" RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                        <Ellipse Fill="#14C27A" Stroke="White" StrokeThickness="3">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="#04361F" /></Ellipse.Effect>
                        </Ellipse>
                        <Path x:Name="SuccessCheck" Data="{StaticResource CheckGlyph}" Stroke="White" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="26" Height="26" Stretch="Uniform" StrokeDashArray="10" StrokeDashOffset="10" />
                    </Grid>
                    <Grid x:Name="ErrorBadge" Width="58" Height="58" Canvas.Left="196" Canvas.Top="150" RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                        <Ellipse Fill="#E5483D" Stroke="White" StrokeThickness="3">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="#3A0703" /></Ellipse.Effect>
                        </Ellipse>
                        <Path Data="{StaticResource AlertGlyph}" Stroke="White" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="24" Height="24" Stretch="None" Margin="17,17,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </Canvas>

                <!-- Features / tagline -->
                <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,28">
                    <TextBlock x:Name="StageCaption" Text="从环境准备到服务上线" Foreground="White" FontSize="17" FontWeight="Bold" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9" Background="#22FFFFFF">
                            <Path Data="{StaticResource RuntimeGlyph}" Stroke="#BFE3FF" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="运行环境" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="IIS / Nginx / Tomcat / 数据库" Foreground="#A9C4EC" FontSize="11" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9" Background="#22FFFFFF">
                            <Path Data="{StaticResource GlobeGlyph}" Stroke="#BFE3FF" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="网站部署" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="站点配置、证书与产品部署" Foreground="#A9C4EC" FontSize="11" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9" Background="#22FFFFFF">
                            <Path Data="{StaticResource ServiceGlyph}" Stroke="#BFE3FF" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="服务管理" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="进程状态、FRP 与日常维护" Foreground="#A9C4EC" FontSize="11" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="DEPLOY · MANAGE · SIMPLIFY" Foreground="#7FA3D6" FontSize="10" FontWeight="SemiBold" Margin="0,18,0,0" />
                </StackPanel>
            </Grid>

            <!-- ======================= Content ======================= -->
            <Grid Grid.Column="1" Margin="44,16,22,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Background="Transparent" MouseLeftButtonDown="OnDrag">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Click="OnMinimize" ToolTip="最小化"
                                AutomationProperties.AutomationId="MinimizeButton" AutomationProperties.Name="最小化">
                            <Path Data="{StaticResource MinimizeGlyph}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Click="OnCloseClicked" ToolTip="关闭"
                                AutomationProperties.AutomationId="CloseButton" AutomationProperties.Name="关闭">
                            <Path Data="{StaticResource CloseGlyph}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PageHost" Grid.Row="1" Margin="0,0,22,0">

                    <!-- Welcome / options -->
                    <Grid x:Name="WelcomePage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="WelcomeContent">
                            <TextBlock x:Name="WelcomeEyebrow" Style="{StaticResource Eyebrow}" Text="MCPANEL · WINDOWS X64" />
                            <TextBlock Style="{StaticResource Heading}" Text="准备你的部署工作台" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                                       Text="一次安装即可管理运行环境、网站部署与服务。更新或修复时，已有配置、数据库和站点会完整保留。" />

                            <TextBlock Style="{StaticResource Label}" Text="安装位置" Margin="0,24,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PathInput" Style="{StaticResource PathBox}" TextChanged="OnPathChanged"
                                         AutomationProperties.AutomationId="InstallPath" AutomationProperties.Name="安装位置" />
                                <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择目录"
                                        Margin="10,0,0,0" Click="OnBrowse" AutomationProperties.AutomationId="BrowseButton" />
                            </Grid>
                            <TextBlock x:Name="PathNote" FontSize="12" Margin="2,8,0,0" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" />

                            <Border Background="{StaticResource SoftBrush}" CornerRadius="14" Padding="18,14" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Style="{StaticResource Label}" Text="环境就绪检查" />
                                        <TextBlock x:Name="SpaceNote" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel x:Name="CheckList" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <CheckBox x:Name="DesktopShortcut" Style="{StaticResource Switch}" Content="创建桌面快捷方式" IsChecked="True"
                                      VerticalAlignment="Center" AutomationProperties.AutomationId="DesktopShortcut" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}" Content="取消" Click="OnCloseClicked" AutomationProperties.AutomationId="CancelButton" />
                                <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="开始安装" Margin="10,0,0,0" MinWidth="150"
                                        Click="OnInstall" AutomationProperties.AutomationId="InstallButton" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Uninstall confirmation -->
                    <Grid x:Name="ConfirmPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="ConfirmContent">
                            <TextBlock Style="{StaticResource Eyebrow}" Text="维护 · 完整卸载" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Style="{StaticResource Heading}" Text="完整卸载 MCPanel" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Body}" Text="清理此工作台创建和管理的内容" Margin="0,8,0,0" />

                            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="14" Padding="18,16" Margin="0,22,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="30" Height="30" VerticalAlignment="Top">
                                        <Path Data="{StaticResource WarnTriangle}" Fill="#F29A1F" Stretch="Uniform" StrokeLineJoin="Round" Stroke="#F29A1F" StrokeThickness="2" />
                                        <Path Data="{StaticResource AlertGlyph}" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="24" Height="24" Margin="3,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="卸载前请备份需要保留的业务数据" FontSize="13.5" FontWeight="Bold" Foreground="#8A4205" />
                                        <TextBlock Style="{StaticResource Body}" Foreground="#8C5A2B" Margin="0,6,0,0"
                                                   Text="将删除安装目录内的配置、数据库、站点、组件和缓存，并移除 MCPanel 管理的服务、快捷方式及启动项。此操作无法撤销。" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="RemovalList" Margin="0,16,0,0" />
                            <TextBlock x:Name="UninstallLocation" FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="2,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="取消" Click="OnCloseClicked" AutomationProperties.AutomationId="CancelUninstallButton" />
                            <Button x:Name="ConfirmUninstallButton" Style="{StaticResource DangerButton}" Content="确认并完整卸载" Margin="10,0,0,0"
                                    Click="OnConfirmUninstall" AutomationProperties.AutomationId="ConfirmUninstallButton" />
                        </StackPanel>
                    </Grid>

                    <!-- Progress (install and uninstall) -->
                    <Grid x:Name="ProgressPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="ProgressContent">
                            <TextBlock x:Name="ProgressEyebrow" Style="{StaticResource Eyebrow}" Text="正在部署" />
                            <TextBlock x:Name="ProgressHeading" Style="{StaticResource Heading}" Text="正在准备部署工作台" Margin="0,8,0,0" />
                            <TextBlock x:Name="ProgressSub" Style="{StaticResource Body}" Margin="0,8,0,0" Text="请稍候，安装期间可以继续使用电脑。" />
                            <StackPanel x:Name="StepList" Margin="0,22,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Grid>
                                <TextBlock x:Name="ProgressTitle" Style="{StaticResource Label}" Text="准备中" />
                                <TextBlock x:Name="ProgressPercent" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" Text="0%" />
                            </Grid>
                            <Grid x:Name="Track" Height="8" Margin="0,10,0,0" ClipToBounds="True">
                                <Border Background="{StaticResource TrackBrush}" CornerRadius="4" />
                                <Border x:Name="ProgressFill" CornerRadius="4" Background="{StaticResource ProgressBrush}" HorizontalAlignment="Left" Width="0">
                                    <Grid ClipToBounds="True">
                                        <Rectangle x:Name="Shimmer" Width="90" HorizontalAlignment="Left">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                                    <GradientStop Color="#66FFFFFF" Offset="0.5" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform x:Name="ShimmerShift" X="-90" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <TextBlock x:Name="ProgressDetail" FontSize="12" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,120,0" VerticalAlignment="Center" />
                                <Button x:Name="CancelRunButton" Style="{StaticResource SecondaryButton}" Content="取消" HorizontalAlignment="Right" Height="36" MinWidth="88"
                                        Click="OnCancelRun" AutomationProperties.AutomationId="CancelRunButton" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Result -->
                    <Grid x:Name="ResultPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="ResultContent">
                            <TextBlock x:Name="ResultEyebrow" Style="{StaticResource Eyebrow}" Text="部署完成" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock x:Name="ResultHeading" Style="{StaticResource Heading}" Text="部署工作台已就绪" Margin="0,8,0,0" />
                            <TextBlock x:Name="ResultBody" Style="{StaticResource Body}" Margin="0,8,0,0" />
                            <Border Background="{StaticResource SoftBrush}" CornerRadius="14" Padding="18,6" Margin="0,22,0,0">
                                <StackPanel x:Name="ResultFacts" />
                            </Border>
                            <Border x:Name="ResultWarning" Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="14,10" Margin="0,14,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="ResultWarningText" FontSize="12.5" Foreground="#8A4205" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="ResultSecondary" Style="{StaticResource SecondaryButton}" Content="完成" Click="OnFinish" AutomationProperties.AutomationId="FinishButton" />
                            <Button x:Name="ResultPrimary" Style="{StaticResource PrimaryButton}" Content="启动 MCPanel" Margin="10,0,0,0" MinWidth="150"
                                    Click="OnLaunch" AutomationProperties.AutomationId="LaunchButton" />
                        </StackPanel>
                    </Grid>

                    <!-- Failure -->
                    <Grid x:Name="FailurePage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="FailureContent">
                            <TextBlock Style="{StaticResource Eyebrow}" Text="未完成" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock x:Name="FailureHeading" Style="{StaticResource Heading}" Text="安装未完成" Margin="0,8,0,0" />
                            <TextBlock x:Name="FailureBody" Style="{StaticResource Body}" Margin="0,8,0,0" Text="原程序未修改，可以安全重试。" />
                            <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="14" Padding="16,12" Margin="0,22,0,0">
                                <TextBox x:Name="FailureMessage" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                         FontSize="13" Foreground="#8E1C14" MaxHeight="190" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.AutomationId="FailureMessage" />
                            </Border>
                            <Button x:Name="OpenLogButton" Style="{StaticResource LinkButton}" Content="打开安装日志" Margin="2,12,0,0" HorizontalAlignment="Left" Click="OnOpenLog" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="关闭" Click="OnFinish" AutomationProperties.AutomationId="FailureCloseButton" />
                            <Button x:Name="RetryButton" Style="{StaticResource PrimaryButton}" Content="重试" Margin="10,0,0,0" MinWidth="150"
                                    Click="OnRetry" AutomationProperties.AutomationId="RetryButton" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
