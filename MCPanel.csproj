<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AppIcon\mcpanel-logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);SYSLIB0039</NoWarn>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Version>1.3.66</Version>
    <FileVersion>1.3.66.0</FileVersion>
    <AssemblyVersion>1.3.66.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="10.0.9" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Security" />
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="SharpSvn">
      <HintPath>Vendor\SharpSvn\SharpSvn.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SharpSvn.UI">
      <HintPath>Vendor\SharpSvn\SharpSvn.UI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MCPanel.Tests\**\*.cs" />
    <None Remove="MCPanel.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.*" />
    <None Update="deployment-layout.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Repair-Update.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Restore-Update.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Uninstall-MCPanel.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Installer\RuntimeCleanup.ps1" CopyToOutputDirectory="PreserveNewest" TargetPath="InstallerAssets\RuntimeCleanup.ps1" />
    <None Include="Assets\AppIcon\mcpanel-logo.png" Link="InstallerAssets\Brand.png" CopyToOutputDirectory="PreserveNewest" TargetPath="InstallerAssets\Brand.png" />
    <EmbeddedResource Include="Installer\download-url-migrations.json" LogicalName="MCPanel.DownloadUrlMigrations.json" />
    <None Update="Installer\download-url-migrations.json" CopyToOutputDirectory="PreserveNewest" TargetPath="InstallerAssets\DownloadUrlMigrations.json" />
    <EmbeddedResource Include="Installer\RuntimeCleanup.ps1" LogicalName="MCPanel.RuntimeCleanup.ps1" />
    <EmbeddedResource Include="Installer\SqlServerCertificate.ps1" LogicalName="MCPanel.SqlServerCertificate.ps1" />
  </ItemGroup>

</Project>



