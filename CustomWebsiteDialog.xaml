<Window x:Class="MCPanel.CustomWebsiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IIS 网站配置" Width="780" Height="750" MinWidth="520" MinHeight="520" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource PageBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/PanelDialogControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource PageBrush}" ClipToBounds="True">
        <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="736" Height="706" Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="新建 IIS 网站" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="网站、应用程序池、域名绑定、SSL、HTTPS 跳转、MIME 和带宽会一次授权后统一配置。"
                       Margin="0,7,0,14" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="17">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="网站名称" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                            <TextBox x:Name="NameBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="HTTP 端口" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                            <TextBox x:Name="HttpPortBox"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="网站根目录" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                            <TextBox x:Name="PhysicalPathBox"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="浏览" VerticalAlignment="Bottom" Margin="0" Click="BrowseRoot_Click"/>
                    </Grid>
                    <StackPanel Margin="0,13,0,0">
                        <TextBlock Text="域名（可留空；多个域名用逗号、空格或换行分隔）" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="DomainsBox" Height="55" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="应用程序池运行时" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="RuntimeBox" SelectedValuePath="Tag">
                                <ComboBoxItem Content=".NET CLR v4.0" Tag="v4.0"/>
                                <ComboBoxItem Content=".NET CLR v2.0/3.5" Tag="v2.0"/>
                                <ComboBoxItem Content="无托管代码" Tag=""/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="Enable32BitBox" Content="启用 32 位应用" VerticalAlignment="Bottom" Margin="0,0,14,9"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="带宽上限 KB/s（0 不限）" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                            <TextBox x:Name="BandwidthBox"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="SslBox" Content="启用 HTTPS（使用 PFX/P12 证书）" Margin="0,17,0,0" Checked="SslOptionChanged" Unchecked="SslOptionChanged"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="PFX/P12 证书（编辑时可留空以复用已导入证书）" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                            <TextBox x:Name="PfxPathBox"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="浏览" VerticalAlignment="Bottom" Margin="0,0,10,0" Click="BrowsePfx_Click"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="HTTPS 端口" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                            <TextBox x:Name="HttpsPortBox"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="PFX 密码" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="PfxPasswordBox"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="RedirectBox" Content="HTTP 永久跳转到 HTTPS" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
                    </Grid>
                    <StackPanel Margin="0,13,0,0">
                        <TextBlock Text="自定义 MIME（每行：.扩展名=mime/type）" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="MimeBox" Height="72" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Margin="0,13,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                               Text="保存会触发一次管理员授权；业务文件不会被面板删除。"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="取消" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="保存并应用" IsDefault="True" Background="{DynamicResource PrimaryBrush}" Foreground="White" Click="Save_Click"/>
        </StackPanel>
        </Grid>
        </Viewbox>
    </Grid>
</Window>
