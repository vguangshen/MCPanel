<local:PanelModalWindow x:Class="MCPanel.PlatformBindingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MCPanel">
    <local:PanelModalWindow.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Resources/PanelDialogControls.xaml" />
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </local:PanelModalWindow.Resources>
    <Border Style="{StaticResource PanelModalSurface}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource PanelModalTitle}" />
                <TextBlock Text="选择已下载的平台，创建或修复运行环境绑定。" Style="{StaticResource PanelModalSubtitle}" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource PanelModalContentCard}" Margin="0,20,0,18" Padding="18">
                <StackPanel>
                    <TextBlock Text="平台软件（输入名称或编号筛选）" Foreground="{DynamicResource DialogMutedBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" AutomationProperties.Name="筛选待绑定平台" />
                    <ComboBox x:Name="ProductBox" Margin="0,8,0,0" DisplayMemberPath="Label" SelectionChanged="Product_SelectionChanged" AutomationProperties.Name="选择待绑定平台" />
                    <TextBlock Text="软件目录" Foreground="{DynamicResource DialogMutedBrush}" Margin="0,16,0,6" />
                    <TextBox x:Name="PathBox" IsReadOnly="True" AutomationProperties.Name="待绑定软件目录" />
                    <TextBlock x:Name="HintText" Foreground="{DynamicResource DialogMutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource DialogMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <Button x:Name="CustomIisButton" Content="绑定其他 IIS 目录" HorizontalAlignment="Left" Click="CustomIis_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" IsCancel="True" />
                    <Button x:Name="BindButton" Content="确认绑定" IsDefault="True" Style="{StaticResource PrimaryDialogButton}" Click="Bind_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</local:PanelModalWindow>
